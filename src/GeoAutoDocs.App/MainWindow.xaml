                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
                        <Grid x:Name="OverviewWorkspace">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewProjectName" Style="{StaticResource SectionTitleTextStyle}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="OverviewClientName" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,18" TextTrimming="CharacterEllipsis"/>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="OverviewReportsCount" FontSize="28" FontWeight="Bold"/><TextBlock Text="Relatórios" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="OverviewSectionsCount" FontSize="28" FontWeight="Bold"/><TextBlock Text="Trechos" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="OverviewOccurrencesCount" FontSize="28" FontWeight="Bold"/><TextBlock Text="Anomalias" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                                            <StackPanel><TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBlock x:Name="OverviewUpdatedAt" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,2"/></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ações rápidas" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="ContinueInspection_Click" HorizontalContentAlignment="Center" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Continuar inspeção"/></StackPanel></Button>
                                            <Button Click="OverviewNewReport_Click" HorizontalContentAlignment="Center" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Novo relatório"/></StackPanel></Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="RESUMO DO PROJETO" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,13"/>
                                        <TextBlock Text="CLIENTE" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultClientBox" Background="{StaticResource SurfaceRaisedBrush}" TextChanged="FieldChanged"/>
                                        <TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultCnpjBox" Background="{StaticResource SurfaceRaisedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextChanged="FieldChanged"/>
                                        <TextBlock Text="ÁREA / LOCALIZAÇÃO" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultAreaBox" Background="{StaticResource SurfaceRaisedBrush}" TextChanged="FieldChanged"/>
                                        <TextBlock Text="CONTRATO" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultContractBox" Background="{StaticResource SurfaceRaisedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextChanged="FieldChanged"/>
                                        <TextBlock Text="PEDIDO DE COMPRA" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultPurchaseOrderBox" Background="{StaticResource SurfaceRaisedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextChanged="FieldChanged"/>
                                        <TextBlock Text="As alterações são salvas automaticamente e herdadas por novos relatórios." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" MinHeight="390">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
