                                            <ItemsControl x:Name="OverviewActivityList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding When}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18" MinHeight="390">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="ÚLTIMOS RELATÓRIOS" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource TextMutedBrush}"/>
                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <StackPanel x:Name="OverviewLatestReportsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Nenhum relatório criado" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock Text="Clique em “Novo relatório” para começar." Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                            <ItemsControl x:Name="OverviewLatestReportsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Abrir" Tag="{Binding Id}" Click="OpenOverviewReport_Click" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18" Margin="0,14,0,8">
                                <StackPanel><TextBlock Text="LOGO DO CLIENTE" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/><Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="DefaultLogoPreview" Width="78" Height="50" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock x:Name="DefaultLogoStatus" Text="Nenhuma imagem selecionada" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="PNG ou JPG" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button x:Name="DefaultLogoButton" Grid.Column="2" Content="Alterar imagem" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center" Click="SelectDefaultLogo_Click"/><TextBox x:Name="DefaultLogoBox" Visibility="Collapsed"/></Grid></Border></StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="InspectionsTab" Header="Inspeção">
                    <TabItem.Resources>
                        <Style x:Key="AnomalyDashboardCardStyle" TargetType="Border">
                            <Setter Property="Background" Value="#0C1B28"/>
                            <Setter Property="BorderBrush" Value="#1E3547"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,0,0,9"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#102333"/>
                                    <Setter Property="BorderBrush" Value="#31536B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="AnomalyCardActionStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Margin" Value="5,0,0,0"/>
                            <Setter Property="Foreground" Value="#38AFFF"/>
                        </Style>
                    </TabItem.Resources>
                    <Grid x:Name="InspectionLayoutRoot" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="PlayerColumn" Width="*"/><ColumnDefinition x:Name="InspectionSplitterColumn" Width="4"/><ColumnDefinition x:Name="InspectionSideColumn" Width="320"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                            <Expander x:Name="InspectionContextExpander" Grid.ColumnSpan="3" Header="Local / Trecho / Vídeo" IsExpanded="True" Expanded="InspectionLayoutPreferenceChanged" Collapsed="InspectionLayoutPreferenceChanged" Margin="0,0,0,8">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="0,0,6,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8"><Button x:Name="AddLocationButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Margin="4,0,0,0" Click="AddLocation_Click" ToolTip="Criar local"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#173F70" Margin="0,0,8,0"><TextBlock Text="1" FontWeight="Bold" Foreground="#55B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Local" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="LocationsList" DisplayMemberPath="Name" SelectionChanged="LocationsList_SelectionChanged" Margin="0,0,6,0" MinWidth="80" ToolTip="Selecione o local da inspeção"/>
                                            <Button x:Name="RenameLocationButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" Margin="0,0,4,0" Click="RenameLocation_Click" ToolTip="Renomear local"/>
                                            <Button x:Name="DeleteLocationButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}" Click="DeleteLocation_Click" ToolTip="Excluir local"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="6,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8"><Button x:Name="AddSectionButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Margin="4,0,0,0" Click="AddSection_Click" ToolTip="Criar trecho"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#173F70" Margin="0,0,8,0"><TextBlock Text="2" FontWeight="Bold" Foreground="#55B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Trecho" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="SectionsList" SelectionChanged="SectionsList_SelectionChanged" Margin="0,0,6,0" MinWidth="80" TextSearch.TextPath="Name" ToolTip="Selecione o trecho; com a lista aberta, arraste pelo puxador para reordenar">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid AllowDrop="True" PreviewMouseMove="SectionsList_PreviewMouseMove" DragOver="SectionsList_DragOver" Drop="SectionsList_Drop">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="⠿" Cursor="SizeNS" Foreground="{StaticResource TextMutedBrush}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" PreviewMouseLeftButtonDown="SectionsList_PreviewMouseLeftButtonDown" ToolTip="Arraste para cima ou para baixo"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding StartPoint}"/><Run Text=" → "/><Run Text="{Binding EndPoint}"/></TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="EditSectionButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" Margin="0,0,4,0" Click="EditSection_Click" ToolTip="Editar trecho" ToolTipService.ShowOnDisabled="True"/>
                                            <Button x:Name="DeleteSectionButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}" Click="DeleteSection_Click" ToolTip="Excluir trecho"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Padding="12" Margin="6,0,0,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,8"><Button x:Name="AddVideoButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Margin="4,0,0,0" Click="AddVideo_Click" ToolTip="Adicionar vídeo"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#173F70" Margin="0,0,8,0"><TextBlock Text="3" FontWeight="Bold" Foreground="#55B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Vídeo" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="VideosList" SelectionChanged="VideosList_SelectionChanged" Margin="0" MinWidth="80" TextSearch.TextPath="DisplayName" ToolTip="Selecione o vídeo para revisar"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Availability}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                            <Button x:Name="ReloadVideoButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Margin="6,0,0,0" Click="RetryVideo_Click" IsEnabled="False" ToolTip="Recarregar vídeo"/>
                                            <Button x:Name="RelocateVideoButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE838;" Margin="6,0,0,0" Click="RelocateVideo_Click" IsEnabled="False" Visibility="Collapsed" ToolTip="Localizar arquivo ausente"/>
                                            <Button x:Name="RemoveVideoButton" Grid.Column="3" Style="{StaticResource DangerButtonStyle}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" MinWidth="38" Width="38" Padding="4" Margin="6,0,0,0" Click="RemoveVideo_Click" IsEnabled="False" ToolTip="Remover referência do vídeo"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Expander>

                            <Border x:Name="PlayerContainer" Grid.Row="1" Grid.Column="0" Background="#02070B" CornerRadius="7" BorderBrush="#203547" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <vlc:VideoView x:Name="VideoView" MouseDoubleClick="VideoView_MouseDoubleClick"/>
                                        <Grid x:Name="VideoOverlayLayer">
                                            <StackPanel x:Name="VideoEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
                                                <Border Width="54" Height="54" CornerRadius="27" Background="#132535" HorizontalAlignment="Center" Margin="0,0,0,13"><TextBlock x:Name="VideoStateIcon" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock x:Name="VideoStateTitle" Text="Selecione o contexto da inspeção" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="VideoMessage" Text="Escolha um local, um trecho e um vídeo para iniciar." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <WrapPanel HorizontalAlignment="Center" Margin="0,13,0,0"><Button x:Name="EmptyVideoButton" Content="Adicionar vídeo" Style="{StaticResource PrimaryButtonStyle}" Margin="4" Click="AddVideo_Click" Visibility="Collapsed"/><Button x:Name="EmptyRelocateVideoButton" Content="Localizar arquivo" Style="{StaticResource PrimaryButtonStyle}" Margin="4" Click="RelocateVideo_Click" Visibility="Collapsed"/><Button x:Name="RetryVideoButton" Content="Tentar novamente" Margin="4" Click="RetryVideo_Click" Visibility="Collapsed"/></WrapPanel>
                                            </StackPanel>
                                            <Border x:Name="VideoLoadedBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="10,6" CornerRadius="5" Background="#D90A1923"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="Vídeo carregado" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
                                            <Button x:Name="CaptureFrameOverlayButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureFrame_Click" ToolTip="Capturar o frame atual e cadastrar uma anomalia"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock x:Name="CaptureFrameOverlayText" Text="Capturar evidência"/></StackPanel></Button>
                                            <Border x:Name="ReadOnlyInspectionBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" Padding="10,6" CornerRadius="5" Background="#D9321C23" BorderBrush="#67323C" BorderThickness="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" Margin="0,0,7,0"/><TextBlock Text="Somente leitura" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
                                            <Border x:Name="CapturePreviewPanel" Background="#F50D1924" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="8" Padding="18" Margin="18" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1080">
                                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <DockPanel><Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right" Click="RetakeCapture_Click" ToolTip="Fechar preview"/><StackPanel><TextBlock Text="Conferir captura" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Cadastre a anomalia agora ou deixe a imagem pendente para revisar depois." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
                                                    <Image x:Name="CapturePreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,10"/>
                                                    <TextBlock x:Name="CapturePreviewTimestamp" Grid.Row="2" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="Refazer captura" Click="RetakeCapture_Click"/><Button Content="Deixar pendente" Click="AcceptCapture_Click"/><Button Content="Cadastrar anomalia" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Abre o cadastro com esta imagem, vídeo e momento associados." Click="CreateOccurrenceFromCapture_Click"/></WrapPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    <Grid x:Name="PlayerControlsLayer" Grid.Row="1" Background="#09131D" Margin="14,9">
