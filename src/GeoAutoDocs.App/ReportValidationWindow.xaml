<Window x:Class="GeoAutoDocs.App.ReportValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validação do relatório" Width="610" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="VALIDAÇÃO DO RELATÓRIO" FontSize="22" FontWeight="SemiBold" Foreground="#173C44"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,12,0,14" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="ErrorsPanel" Background="#FDEBEC" BorderBrush="#C84B55" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="ERROS BLOQUEANTES" FontWeight="SemiBold" Foreground="#8E2029"/><TextBlock x:Name="ErrorsText" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border x:Name="WarningsPanel" Background="#FFF6DF" BorderBrush="#C99026" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel><TextBlock Text="AVISOS" FontWeight="SemiBold" Foreground="#805A16"/><TextBlock x:Name="WarningsText" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="VOLTAR E CORRIGIR" IsCancel="True"/>
            <Button x:Name="GenerateButton" Content="GERAR RELATÓRIO" Margin="8,0,0,0" IsDefault="True" Click="Generate_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
