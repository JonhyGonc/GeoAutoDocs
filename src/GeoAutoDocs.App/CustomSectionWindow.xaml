<Window x:Class="GeoAutoDocs.App.CustomSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etapa personalizada" Height="700" Width="860" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24" MaxWidth="820" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Etapa personalizada" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/><TextBlock Text="Título (opcional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,18,0,6"/><TextBox x:Name="TitleBox"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="Texto" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="TextBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource SubtleCardStyle}" Margin="0,4,0,12"><DockPanel>
            <Button Content="Adicionar imagens" DockPanel.Dock="Top" HorizontalAlignment="Left" Click="AddImages_Click"/>
            <ListBox x:Name="ImagesList" Margin="0,8,0,8"/>
        </DockPanel></Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True"/>
            <Button Content="Adicionar" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
