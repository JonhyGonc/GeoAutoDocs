<Window x:Class="GeoAutoDocs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GeoAutoDocs" Height="900" Width="1500" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="22,28,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GeoAutoDocs" FontSize="22" FontWeight="Bold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Relatórios de vídeo inspeção" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,5,0,0"/>
                    <TextBlock Text="Desktop" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,38,0,0">
                    <TextBlock Text="NAVEGAÇÃO" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="4,0,0,10"/>
                    <Border Background="#173A52" CornerRadius="7" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Projetos" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="APARÊNCIA" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="4,0,0,10"/>
                    <Border Style="{StaticResource SubtleCardStyle}" Padding="12">
                        <DockPanel>
                            <TextBlock Text="Escuro" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Tema" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="GeoAutoDocs • Desktop" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="ProjectsView" Margin="32,30,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="PROJETOS" Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Gerencie seus projetos de vídeo inspeção" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                    <Button Content="＋  NOVO PROJETO" Style="{StaticResource PrimaryButtonStyle}" MinWidth="230" Margin="0" Click="NewProject_Click"/>
                    <Grid Grid.Column="2">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="13,0,0,13" Panel.ZIndex="1" IsHitTestVisible="False"/>
                        <TextBox x:Name="ProjectsSearchBox" Padding="40,9,12,9" Margin="0" ToolTip="Pesquisar projetos por nome ou cliente"
                                 TextChanged="ProjectsSearchBox_TextChanged"/>
                        <TextBlock x:Name="ProjectsSearchHint" Text="Pesquisar projetos..." Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="40,0,0,13" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource BorderBrush}"/>

                <ListView x:Name="ProjectsList" Grid.Row="3" Margin="0,16,0,0" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,8,9"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="17" Background="{StaticResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="9" Background="#123A53" HorizontalAlignment="Left">
                                        <Path Data="M 3,7 L 10,7 L 13,10 L 25,10 L 25,22 L 3,22 Z" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                              Width="28" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Cliente" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding DefaultClient, TargetNullValue='Não informado'}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Reports.Count, StringFormat={}{0} relatório(s)}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Abrir" Tag="{Binding Id}" Click="OpenProject_Click" Foreground="{StaticResource PrimaryBrush}" ToolTip="Abrir projeto"/>
                                        <Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}" Tag="{Binding Id}" Click="RenameProject_Click" ToolTip="Renomear projeto"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource DangerButtonStyle}" FontFamily="Segoe MDL2 Assets" Tag="{Binding Id}" Click="DeleteProject_Click" ToolTip="Excluir projeto"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="EditorView" Visibility="Collapsed" Margin="28,22,32,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="←  Voltar" Margin="0,0,18,0" VerticalAlignment="Top" Click="Back_Click"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PROJETO" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="ProjectTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="24" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,0">
                            <TextBlock x:Name="StorageStatus" Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                        <Button x:Name="ShareProjectButton" Content="Compartilhar" Click="ShareProject_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource SubtleCardStyle}" Margin="0,16,0,10" Padding="14,10">
                    <DockPanel>
                        <Button x:Name="NewReportButton" Content="＋  NOVO RELATÓRIO" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Click="NewReport_Click"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Relatório ativo" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="ReportsCombo" Width="235" DisplayMemberPath="Name" SelectionChanged="ReportsCombo_SelectionChanged"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="ReportEditorTabs" Grid.Row="2" Margin="0,0,0,8">
                    <TabItem x:Name="ProjectDefaultsTab" Header="DADOS DO PROJETO">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,8,0">
                            <Border Style="{StaticResource CardStyle}" Padding="26">
                                <StackPanel>
                                    <TextBlock Text="Dados padrão dos relatórios" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Estes dados são aplicados automaticamente aos novos relatórios." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,22"/>
                                    <Grid MaxWidth="900" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="28"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock Text="Cliente padrão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultClientBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="CNPJ padrão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultCnpjBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="1"><TextBlock Text="Área / localização padrão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultAreaBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Contrato padrão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultContractBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="2"><TextBlock Text="Pedido de compra padrão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultPurchaseOrderBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Logo padrão" Style="{StaticResource FieldLabelTextStyle}"/>
                                            <DockPanel><Button Content="Selecionar imagem" DockPanel.Dock="Right" Margin="8,0,0,14" Click="SelectDefaultLogo_Click"/><TextBox x:Name="DefaultLogoBox" IsReadOnly="True"/></DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="ReportHeaderTab" Header="CABEÇALHO DO RELATÓRIO">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,8,0">
                            <Border Style="{StaticResource CardStyle}" Padding="26">
                                <StackPanel>
                                    <TextBlock Text="Identificação do relatório" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,20"/>
                                    <Grid MaxWidth="900" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="28"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ClientBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="CnpjBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="1"><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="AreaBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ContractBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="2"><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="PurchaseOrderBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Código do relatório" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReportCodeBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="3"><TextBlock Text="Data" Style="{StaticResource FieldLabelTextStyle}"/><DatePicker x:Name="ReportDatePicker" Margin="0,0,0,14" SelectedDateChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Descrição da localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="LocationBox" TextChanged="FieldChanged"/></StackPanel>
                                        <StackPanel Grid.Row="4"><TextBlock Text="Metragem total (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="MetersBox" TextChanged="FieldChanged"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="WordConfigTab" Header="RELATÓRIO FINAL">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,8,0">
                            <Border Style="{StaticResource CardStyle}" Padding="26">
                                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                    <TextBlock Text="Arquivos do relatório" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Template Word" Style="{StaticResource FieldLabelTextStyle}"/><DockPanel><Button Content="Selecionar" DockPanel.Dock="Right" Margin="8,0,0,14" Click="SelectTemplate_Click"/><TextBox x:Name="TemplateBox" IsReadOnly="True"/></DockPanel>
                                    <TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/><DockPanel><Button Content="Selecionar" DockPanel.Dock="Right" Margin="8,0,0,14" Click="SelectLogo_Click"/><TextBox x:Name="LogoBox" IsReadOnly="True"/></DockPanel>
                                    <TextBlock Text="Imagem de localização (Figura 1.1)" Style="{StaticResource FieldLabelTextStyle}"/><DockPanel><Button Content="Selecionar" DockPanel.Dock="Right" Margin="8,0,0,14" Click="SelectLocationImage_Click"/><TextBox x:Name="LocationImageBox" IsReadOnly="True"/></DockPanel>

                                    <TextBlock Text="Equipamentos utilizados" Style="{StaticResource SectionTitleTextStyle}" Margin="0,10,0,10"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="EndoscopeCheck" Content="Endoscópio" Margin="0,5,22,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="BugCheck" Content="BUG" Margin="0,5,22,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="HunterCheck" Content="HUNTER" Margin="0,5,22,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="SpiderCheck" Content="SPIDER" Margin="0,5,22,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="TrackerCheck" Content="TRACKER" Margin="0,5,22,5" Checked="FieldChanged" Unchecked="FieldChanged"/>
                                    </WrapPanel>
                                    <TextBlock Text="Diâmetros filmados" Style="{StaticResource SectionTitleTextStyle}" Margin="0,18,0,10"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="D300Check" Content="300 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D400Check" Content="400 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D500Check" Content="500 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D600Check" Content="600 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D800Check" Content="800 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D1000Check" Content="1000 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D1500Check" Content="1500 mm" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/>
                                    </WrapPanel>
                                    <TextBlock Text="Outros valores (separe por vírgula)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,12,0,6"/><TextBox x:Name="CustomDiametersBox" Width="300" HorizontalAlignment="Left" TextChanged="FieldChanged"/>
                                    <TextBlock Text="Módulos opcionais" Style="{StaticResource SectionTitleTextStyle}" Margin="0,8,0,8"/>
                                    <CheckBox x:Name="OpeningCheck" Content="Abertura de inspeção" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="GprCheck" Content="Complemento GPR / Georadar" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/>
                                    <TextBlock Text="Imagens dinâmicas da Seção 3" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8"/>
                                    <Border Style="{StaticResource SubtleCardStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,3"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar" Tag="VideoInspection" Click="SelectDevelopmentImages_Click"/><Button Content="Usar modelo" Tag="VideoInspection" Click="ClearDevelopmentImages_Click"/></StackPanel><TextBlock x:Name="VideoInspectionImagesText" VerticalAlignment="Center"/></DockPanel>
                                            <DockPanel Margin="0,3"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar" Tag="InspectionOpening" Click="SelectDevelopmentImages_Click"/><Button Content="Usar modelo" Tag="InspectionOpening" Click="ClearDevelopmentImages_Click"/></StackPanel><TextBlock x:Name="OpeningImagesText" VerticalAlignment="Center"/></DockPanel>
                                            <DockPanel Margin="0,3"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar" Tag="Gpr" Click="SelectDevelopmentImages_Click"/><Button Content="Usar modelo" Tag="Gpr" Click="ClearDevelopmentImages_Click"/></StackPanel><TextBlock x:Name="GprImagesText" VerticalAlignment="Center"/></DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel Margin="0,20,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar todos" Click="SelectAllReportSections_Click"/><Button Content="Limpar seleção" Click="ClearReportSections_Click"/></StackPanel>
                                        <TextBlock Text="TRECHOS DO RELATÓRIO" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource SubtleCardStyle}" MaxHeight="190">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportSectionsList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" Tag="{Binding SectionId}" IsChecked="{Binding IsSelected}" Margin="4" Checked="ReportSectionSelectionChanged" Unchecked="ReportSectionSelectionChanged"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    </Border>
                                    <DockPanel Margin="0,20,0,8"><Button Content="＋ Adicionar etapa personalizada" DockPanel.Dock="Right" Click="AddCustomSection_Click"/><TextBlock Text="Etapas personalizadas" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                    <ItemsControl x:Name="CustomSectionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Margin="0,4"><DockPanel><Button Content="Remover" Style="{StaticResource DangerButtonStyle}" DockPanel.Dock="Right" Tag="{Binding Id}" Click="RemoveCustomSection_Click"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="650" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Images.Count, StringFormat={}{0} imagem(ns)}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <WrapPanel Margin="0,24,0,8"><Button Content="VALIDAR E GERAR RELATÓRIO" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateReport_Click"/><Button x:Name="OpenReportButton" Content="ABRIR ARQUIVO" IsEnabled="False" Click="OpenReport_Click"/><Button x:Name="OpenReportFolderButton" Content="ABRIR PASTA" IsEnabled="False" Click="OpenReportFolder_Click"/></WrapPanel>
                                    <TextBlock x:Name="GeneratedReportText" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="InspectionsTab" Header="INSPEÇÕES">
                        <Grid Background="{StaticResource SurfaceBrush}" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,7"><Button x:Name="AddLocationButton" Content="＋ Local" DockPanel.Dock="Right" Click="AddLocation_Click"/><TextBlock Text="LOCAIS" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                    <ListBox x:Name="LocationsList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="LocationsList_SelectionChanged"/>
                                    <DockPanel Grid.Row="2" Margin="0,12,0,7"><Button x:Name="AddSectionButton" Content="＋ Trecho" DockPanel.Dock="Right" Click="AddSection_Click"/><TextBlock Text="TRECHOS" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                    <ListBox x:Name="SectionsList" Grid.Row="3" DisplayMemberPath="Name" SelectionChanged="SectionsList_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="330"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="210"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                    <Border Background="#030608" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                        <vlc:VideoView x:Name="VideoView">
                                            <Grid>
                                                <TextBlock x:Name="VideoMessage" Text="Selecione um trecho e um vídeo." Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <Border x:Name="CapturePreviewPanel" Background="#F20D1924" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="9" Padding="14" Margin="14" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="980">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <DockPanel><Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right" Click="RetakeCapture_Click" ToolTip="Fechar preview"/><TextBlock Text="PREVIEW DA CAPTURA" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                                        <Image x:Name="CapturePreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,8"/>
                                                        <TextBlock x:Name="CapturePreviewTimestamp" Grid.Row="2" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,8,0,0"><Button Content="Refazer captura" Click="RetakeCapture_Click"/><Button Content="USAR IMAGEM / DEIXAR PENDENTE" Style="{StaticResource PrimaryButtonStyle}" Click="AcceptCapture_Click"/><Button Content="Criar ocorrência agora" ToolTip="Abre o formulário técnico com esta captura já associada." Click="CreateOccurrenceFromCapture_Click"/></WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </vlc:VideoView>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}" Padding="11">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,7"><Button x:Name="AddVideoButton" Content="＋ Vídeo" DockPanel.Dock="Right" Click="AddVideo_Click"/><TextBlock Text="VÍDEOS" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                            <ListBox x:Name="VideosList" Grid.Row="1" SelectionChanged="VideosList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Availability}" Foreground="{Binding StatusColor}" FontSize="11"/><TextBlock Text="{Binding PathKind}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                            <Button x:Name="RelocateVideoButton" Grid.Row="2" Content="Localizar arquivo" Click="RelocateVideo_Click" IsEnabled="False"/>
                                            <Button x:Name="RemoveVideoButton" Grid.Row="3" Content="Remover referência" Style="{StaticResource DangerButtonStyle}" Click="RemoveVideo_Click" IsEnabled="False"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"><Button Content="−5s" Click="Back5_Click"/><Button Content="−1s" Click="Back1_Click"/><Button x:Name="PlayPauseButton" Content="▶" Width="48" Click="PlayPause_Click"/><Button Content="+1s" Click="Forward1_Click"/><Button Content="+5s" Click="Forward5_Click"/></StackPanel>
                                    <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="ProgressSlider_DragStarted" PreviewMouseLeftButtonUp="ProgressSlider_DragCompleted"/>
                                    <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00:00.000 / 00:00:00.000" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Velocidade" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/><ComboBox x:Name="SpeedCombo" Width="85" Margin="7,0,16,0" SelectionChanged="SpeedCombo_SelectionChanged"><ComboBoxItem Content="0,25x" Tag="0.25"/><ComboBoxItem Content="0,5x" Tag="0.5"/><ComboBoxItem Content="1,0x" Tag="1" IsSelected="True"/><ComboBoxItem Content="1,5x" Tag="1.5"/><ComboBoxItem Content="2,0x" Tag="2"/></ComboBox><Button x:Name="CaptureFrameButton" Content="CAPTURAR FRAME" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureFrame_Click"/><TextBlock x:Name="ReadOnlyInspectionText" Text="Somente leitura: reprodução liberada; alterações bloqueadas." Foreground="{StaticResource DangerBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CAPTURAS PENDENTES" FontWeight="SemiBold"/>
                                    <ListBox x:Name="CapturesList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Padding="6" Margin="4" Width="180"><StackPanel><Image Source="{Binding Thumbnail}" Height="85" Stretch="Uniform"/><TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="Pendente" Foreground="{StaticResource WarningBrush}"/><WrapPanel><Button Content="Ir para momento" Tag="{Binding Id}" Click="GoToCapture_Click"/><Button Content="Criar ocorrência" Tag="{Binding Id}" Click="CreateOccurrenceFromPending_Click"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteCapture_Click"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                                    <DockPanel Grid.Column="1" Margin="12,0,0,0"><Button x:Name="NewOccurrenceButton" Content="＋ Nova ocorrência" DockPanel.Dock="Right" Click="NewOccurrence_Click"/><TextBlock Text="OCORRÊNCIAS DO TRECHO" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                    <ListBox x:Name="OccurrencesList" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Padding="7" Margin="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Thumbnail}" Height="72" Width="86" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Location}" FontWeight="SemiBold"/><TextBlock Text="{Binding Anomalies}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding EvidenceSummary}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Completeness}" Foreground="{Binding CompletenessColor}"/><WrapPanel><Button Content="Abrir" Tag="{Binding Id}" Click="EditOccurrence_Click"/><Button Content="Ir para o vídeo" Tag="{Binding Id}" Click="GoToOccurrenceVideo_Click" IsEnabled="{Binding CanGoToVideo}"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteOccurrence_Click"/></WrapPanel></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="3" x:Name="SaveStatus" Text="Salvo automaticamente" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
