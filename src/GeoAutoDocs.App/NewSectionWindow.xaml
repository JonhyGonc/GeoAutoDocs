<Window x:Class="GeoAutoDocs.App.NewSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo trecho" Width="740" Height="650" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="26,22" MaxWidth="760" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="FormTitleText" Text="Novo trecho" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/><TextBlock Text="Informe a identificação e, se desejar, complete os dados técnicos." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><Grid Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Identificação "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock><TextBox x:Name="NameBox"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="Ponto inicial (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="StartPointBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Ponto final (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="EndPointBox"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="Diâmetro (mm, opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DiameterBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Metragem investigada (m, opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="InvestigatedMetersBox"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="3"><TextBlock Text="Referência (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReferenceBox"/></StackPanel>
            <StackPanel Grid.Row="4" Grid.ColumnSpan="3"><TextBlock Text="Descrição (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/></StackPanel>
        </Grid></ScrollViewer>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Campos opcionais podem permanecer vazios." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True"/><Button x:Name="SaveButton" Content="Criar trecho" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
