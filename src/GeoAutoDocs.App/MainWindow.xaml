<Window x:Class="GeoAutoDocs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GeoAutoDocs" Height="940" Width="1580" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid x:Name="ProjectsView" Margin="34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Projetos" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Gerencie seus projetos de vídeo inspeção" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,24,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                <Button Content="+  Novo projeto" Style="{StaticResource PrimaryButtonStyle}" MinWidth="190" Margin="0" Click="NewProject_Click"/>
                <Grid Grid.Column="2">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="13,0,0,13" Panel.ZIndex="1" IsHitTestVisible="False"/>
                    <TextBox x:Name="ProjectsSearchBox" Padding="40,9,12,9" Margin="0" ToolTip="Pesquisar projetos por nome ou cliente" TextChanged="ProjectsSearchBox_TextChanged"/>
                    <TextBlock x:Name="ProjectsSearchHint" Text="Pesquisar projetos..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="40,0,0,13" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource BorderBrush}"/>
            <ListView x:Name="ProjectsList" Grid.Row="3" Margin="0,14,0,0" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,9"/><Setter Property="Background" Value="Transparent"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="17" Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="9" Background="#123A53" HorizontalAlignment="Left"><Path Data="M 3,7 L 10,7 L 13,10 L 25,10 L 25,22 L 3,22 Z" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Width="28" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DefaultClient, TargetNullValue='Cliente não informado'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding Reports.Count, StringFormat={}{0} relatório(s)}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Abrir" Tag="{Binding Id}" Click="OpenProject_Click" Foreground="{StaticResource PrimaryBrush}"/><Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}" Tag="{Binding Id}" Click="RenameProject_Click" ToolTip="Renomear projeto"/><Button Content="&#xE74D;" Style="{StaticResource DangerButtonStyle}" FontFamily="Segoe MDL2 Assets" Tag="{Binding Id}" Click="DeleteProject_Click" ToolTip="Excluir projeto"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="EditorView" Visibility="Collapsed" Margin="24,18,28,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="←  Projetos" Margin="0,0,16,0" VerticalAlignment="Center" Click="Back_Click"/>
                <StackPanel Grid.Column="1"><TextBlock x:Name="ProjectTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="23" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProjectClientSummary" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StorageStatus" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/><Button x:Name="ShareProjectButton" Content="Compartilhar" Click="ShareProject_Click"/></StackPanel>
            </Grid>

            <TabControl x:Name="ReportEditorTabs" Grid.Row="1" Margin="0">
                <TabItem x:Name="InspectionsTab" Header="Inspeção">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="300"/><RowDefinition Height="Auto"/><RowDefinition Height="1.55*" MinHeight="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Local" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,13"/>
                            <ComboBox x:Name="LocationsList" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="LocationsList_SelectionChanged" MinWidth="150" Margin="0,0,44,14"/>
                            <Button x:Name="AddLocationButton" Grid.Column="1" Content="+" HorizontalAlignment="Right" Width="38" MinWidth="38" Margin="0,0,2,14" Panel.ZIndex="2" Click="AddLocation_Click" ToolTip="Novo local"/>
                            <TextBlock Grid.Column="2" Text="Trecho" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="14,0,8,13"/>
                            <ComboBox x:Name="SectionsList" Grid.Column="3" DisplayMemberPath="Name" SelectionChanged="SectionsList_SelectionChanged" MinWidth="160" Margin="0,0,44,14"/>
                            <Button x:Name="AddSectionButton" Grid.Column="3" Content="+" HorizontalAlignment="Right" Width="38" MinWidth="38" Margin="0,0,2,14" Panel.ZIndex="2" Click="AddSection_Click" ToolTip="Novo trecho"/>
                            <TextBlock Grid.Column="4" Text="Vídeo" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="14,0,8,13"/>
                            <ComboBox x:Name="VideosList" Grid.Column="5" SelectionChanged="VideosList_SelectionChanged" MinWidth="190" Margin="0,0,44,14"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Availability}" Foreground="{Binding StatusColor}" FontSize="10"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <Button x:Name="AddVideoButton" Grid.Column="5" Content="+" HorizontalAlignment="Right" Width="38" MinWidth="38" Margin="0,0,2,14" Panel.ZIndex="2" Click="AddVideo_Click" ToolTip="Adicionar vídeo"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,13"><Button x:Name="RelocateVideoButton" Content="Localizar" Click="RelocateVideo_Click" IsEnabled="False" ToolTip="Localizar arquivo ausente"/><Button x:Name="RemoveVideoButton" Content="Remover" Style="{StaticResource DangerButtonStyle}" Click="RemoveVideo_Click" IsEnabled="False"/></StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#030608" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <vlc:VideoView x:Name="VideoView">
                                <Grid>
                                    <TextBlock x:Name="VideoMessage" Text="Escolha um trecho e um vídeo para iniciar." Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Border x:Name="CapturePreviewPanel" Background="#F50D1924" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="8" Padding="18" Margin="18" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1080">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel><Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right" Click="RetakeCapture_Click" ToolTip="Fechar preview"/><StackPanel><TextBlock Text="Conferir captura" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Cadastre a anomalia agora ou deixe a imagem pendente para revisar depois." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
                                            <Image x:Name="CapturePreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,10"/>
                                            <TextBlock x:Name="CapturePreviewTimestamp" Grid.Row="2" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="Refazer captura" Click="RetakeCapture_Click"/><Button Content="Deixar pendente" Click="AcceptCapture_Click"/><Button Content="Cadastrar anomalia" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Abre o cadastro com esta imagem, vídeo e momento associados." Click="CreateOccurrenceFromCapture_Click"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </vlc:VideoView>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,8,0,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><Button Content="−5s" Click="Back5_Click"/><Button Content="−1s" Click="Back1_Click"/><Button x:Name="PlayPauseButton" Content="▶" Width="48" Click="PlayPause_Click"/><Button Content="+1s" Click="Forward1_Click"/><Button Content="+5s" Click="Forward5_Click"/></StackPanel>
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="ProgressSlider_DragStarted" PreviewMouseLeftButtonUp="ProgressSlider_DragCompleted"/>
                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00:00.000 / 00:00:00.000" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Velocidade" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/><ComboBox x:Name="SpeedCombo" Width="85" Margin="7,0,16,0" SelectionChanged="SpeedCombo_SelectionChanged"><ComboBoxItem Content="0,25x" Tag="0.25"/><ComboBoxItem Content="0,5x" Tag="0.5"/><ComboBoxItem Content="1,0x" Tag="1" IsSelected="True"/><ComboBoxItem Content="1,5x" Tag="1.5"/><ComboBoxItem Content="2,0x" Tag="2"/></ComboBox><Button x:Name="CaptureFrameButton" Content="Capturar frame" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureFrame_Click"/><TextBlock x:Name="ReadOnlyInspectionText" Text="Somente leitura: alterações bloqueadas." Foreground="{StaticResource DangerBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Anomalias do trecho" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="AnomalySummaryText" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="AnomalyListSearchBox" Width="170" ToolTip="Pesquisar anomalias" TextChanged="AnomalyListFilterChanged"/><ComboBox x:Name="AnomalyStatusFilter" Width="125" Margin="7,0" SelectionChanged="AnomalyListFilterChanged"><ComboBoxItem Content="Todas" Tag="All" IsSelected="True"/><ComboBoxItem Content="Completas" Tag="Complete"/><ComboBoxItem Content="Incompletas" Tag="Incomplete"/></ComboBox><Button x:Name="NewOccurrenceButton" Content="+  Cadastrar anomalia" Style="{StaticResource PrimaryButtonStyle}" Click="NewOccurrence_Click"/></StackPanel></Grid>
                            <ListBox x:Name="OccurrencesList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="8" Margin="3" Width="380"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Thumbnail}" Height="78" Width="88" Stretch="Uniform"/><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding Completeness}" DockPanel.Dock="Right" Foreground="{Binding CompletenessColor}" FontSize="11"/><TextBlock Text="{Binding Location}" FontSize="15" FontWeight="Bold"/></DockPanel><TextBlock Text="{Binding Anomalies}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding EvidenceSummary}" Foreground="{StaticResource TextMutedBrush}"/><WrapPanel><Button Content="Editar" Tag="{Binding Id}" Click="EditOccurrence_Click"/><Button Content="Duplicar" Tag="{Binding Id}" Click="DuplicateOccurrence_Click" IsEnabled="{Binding CanModify}"/><Button Content="Ir ao vídeo" Tag="{Binding Id}" Click="GoToOccurrenceVideo_Click" IsEnabled="{Binding CanGoToVideo}"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteOccurrence_Click" IsEnabled="{Binding CanModify}"/></WrapPanel></StackPanel></Grid></Border>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                        </Grid>

                        <Expander Grid.Row="4" Margin="0,8,0,0"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Capturas pendentes" FontWeight="SemiBold"/><TextBlock x:Name="PendingCapturesSummary" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/></StackPanel></Expander.Header>
                            <ListBox x:Name="CapturesList" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="6" Margin="4" Width="180"><StackPanel><Image Source="{Binding Thumbnail}" Height="80" Stretch="Uniform"/><TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/><WrapPanel><Button Content="Cadastrar" Tag="{Binding Id}" Click="CreateOccurrenceFromPending_Click"/><Button Content="Ir ao vídeo" Tag="{Binding Id}" Click="GoToCapture_Click"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteCapture_Click"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </Expander>
                    </Grid>
                </TabItem>

                <TabItem x:Name="WordConfigTab" Header="Relatórios">
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0"><DockPanel Margin="0,0,0,10"><Button x:Name="NewReportButton" Content="+  Novo relatório" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Click="NewReport_Click"/><TextBlock Text="Relatórios" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                            <ComboBox x:Name="ReportsCombo" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="ReportsCombo_SelectionChanged"/>
                            <ListBox x:Name="ReportsList" SelectionChanged="ReportsList_SelectionChanged" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="13" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='Data não informada'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SectionLinks.Count, StringFormat={}{0} trecho(s)}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Abrir preparação" Foreground="{StaticResource PrimaryBrush}" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                                <StackPanel Margin="0,0,0,16"><TextBlock x:Name="ActiveReportTitle" Text="Selecione um relatório" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/><TextBlock Text="Preparação do documento" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                <Grid x:Name="ReportHeaderTab" Visibility="Collapsed"><TextBox x:Name="ClientBox"/><TextBox x:Name="CnpjBox"/><TextBox x:Name="AreaBox"/><TextBox x:Name="ContractBox"/><TextBox x:Name="PurchaseOrderBox"/><TextBox x:Name="TemplateBox"/><TextBox x:Name="LogoBox"/></Grid>
                                <TextBlock Text="Dados da emissão" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Grid Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Código" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReportCodeBox" TextChanged="FieldChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Data" Style="{StaticResource FieldLabelTextStyle}"/><DatePicker x:Name="ReportDatePicker" SelectedDateChanged="FieldChanged"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Metragem total (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="MetersBox" TextChanged="FieldChanged"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Descrição complementar da localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="LocationBox" TextChanged="FieldChanged" Margin="0,0,0,16"/>

                                <TextBlock Text="Conteúdo" Style="{StaticResource SectionTitleTextStyle}"/>
                                <StackPanel Margin="0,8,0,14"><CheckBox Content="Vídeo inspeção" IsChecked="True" IsEnabled="False"/><CheckBox x:Name="OpeningCheck" Content="Abertura de inspeção" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="GprCheck" Content="Complemento GPR / Georadar" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/></StackPanel>

                                <TextBlock Text="Imagem de localização" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="12" Margin="0,8,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="LocationImagePreview" Width="140" Height="90" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0"><TextBlock x:Name="LocationImageStatus" Text="Nenhuma imagem selecionada" FontWeight="SemiBold"/><TextBlock Text="A imagem será inserida automaticamente no relatório." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="Alterar imagem" VerticalAlignment="Center" Click="SelectLocationImage_Click"/><TextBox x:Name="LocationImageBox" Visibility="Collapsed"/></Grid></Border>

                                <TextBlock Text="Imagens do desenvolvimento" Style="{StaticResource SectionTitleTextStyle}"/>
                                <StackPanel Margin="0,8,0,16"><DockPanel Margin="0,3"><Button Content="Alterar" Tag="VideoInspection" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock x:Name="VideoInspectionImagesText" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,3"><Button Content="Alterar" Tag="InspectionOpening" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock x:Name="OpeningImagesText" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,3"><Button Content="Alterar" Tag="Gpr" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock x:Name="GprImagesText" VerticalAlignment="Center"/></DockPanel></StackPanel>

                                <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar todos" Click="SelectAllReportSections_Click"/><Button Content="Limpar" Click="ClearReportSections_Click"/></StackPanel><TextBlock Text="Trechos do relatório" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10" MaxHeight="190"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportSectionsList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" Tag="{Binding SectionId}" IsChecked="{Binding IsSelected}" Margin="4" Checked="ReportSectionSelectionChanged" Unchecked="ReportSectionSelectionChanged"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>

                                <Expander Header="Mais detalhes" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="Equipamentos" Style="{StaticResource FieldLabelTextStyle}"/><WrapPanel><CheckBox x:Name="EndoscopeCheck" Content="Endoscópio" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="BugCheck" Content="BUG" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="HunterCheck" Content="HUNTER" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="SpiderCheck" Content="SPIDER" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="TrackerCheck" Content="TRACKER" Margin="0,5,18,5" Checked="FieldChanged" Unchecked="FieldChanged"/></WrapPanel><TextBlock Text="Diâmetros filmados" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,0"/><WrapPanel><CheckBox x:Name="D300Check" Content="300 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D400Check" Content="400 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D500Check" Content="500 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D600Check" Content="600 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D800Check" Content="800 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D1000Check" Content="1000 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="D1500Check" Content="1500 mm" Margin="0,5,14,5" Checked="FieldChanged" Unchecked="FieldChanged"/></WrapPanel><TextBlock Text="Outros diâmetros" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="CustomDiametersBox" Width="300" HorizontalAlignment="Left" TextChanged="FieldChanged"/></StackPanel></Expander>

                                <DockPanel Margin="0,18,0,8"><Button Content="+  Adicionar seção" DockPanel.Dock="Right" Click="AddCustomSection_Click"/><TextBlock Text="Etapas adicionais" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                <ItemsControl x:Name="CustomSectionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" Margin="0,4"><DockPanel><Button Content="Remover" Style="{StaticResource DangerButtonStyle}" DockPanel.Dock="Right" Tag="{Binding Id}" Click="RemoveCustomSection_Click"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="650" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Images.Count, StringFormat={}{0} imagem(ns)}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,8"><Button x:Name="OpenReportButton" Content="Abrir arquivo" IsEnabled="False" Click="OpenReport_Click"/><Button x:Name="OpenReportFolderButton" Content="Abrir pasta" IsEnabled="False" Click="OpenReportFolder_Click"/><Button Content="Gerar relatório" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateReport_Click" MinWidth="170"/></StackPanel>
                                <TextBlock x:Name="GeneratedReportText" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ProjectDefaultsTab" Header="Dados do projeto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0"><StackPanel MaxWidth="940" HorizontalAlignment="Left"><TextBlock Text="Dados do projeto" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/><TextBlock Text="Estas informações são herdadas automaticamente pelos novos relatórios." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultClientBox" TextChanged="FieldChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultCnpjBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultAreaBox" TextChanged="FieldChanged"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultContractBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultPurchaseOrderBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="DefaultLogoPreview" Width="80" Height="58" Stretch="Uniform"/><TextBlock x:Name="DefaultLogoStatus" Grid.Column="1" Text="Nenhuma imagem selecionada" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0"/><Button Grid.Column="2" Content="Alterar imagem" VerticalAlignment="Center" Click="SelectDefaultLogo_Click"/><TextBox x:Name="DefaultLogoBox" Visibility="Collapsed"/></Grid></Border></StackPanel>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="2" x:Name="SaveStatus" Text="✓ Salvo" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,6,0,0"/>
        </Grid>
    </Grid>
</Window>
