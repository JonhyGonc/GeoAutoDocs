<Window x:Class="GeoAutoDocs.App.ReportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:review="clr-namespace:GeoAutoDocs.Core.Review;assembly=GeoAutoDocs.Core"
        Title="Revisão do Relatório" Width="920" Height="720" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelReviewButton" Content="Cancelar" Visibility="Collapsed"
                        Click="CancelReview_Click"/>
                <Button x:Name="RunReviewButton" Content="Executar revisão"
                        Style="{StaticResource PrimaryButtonStyle}" Click="RunReview_Click"/>
                <Button Content="Fechar" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Revisão do Relatório" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Name="ReviewStatusText" Text="Execute a revisão para analisar o relatório atual."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Erros" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ErrorCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Avisos" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WarningCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Informações" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InfoCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2">
            <Border x:Name="StaleBanner" Visibility="Collapsed" Style="{StaticResource SubtleCardStyle}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Projeto alterado após a revisão" Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Execute a revisão novamente para atualizar os resultados."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="IncompleteBanner" Visibility="Collapsed" Style="{StaticResource SubtleCardStyle}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Revisão incompleta" Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Uma ou mais verificações não puderam ser executadas. Os demais resultados continuam disponíveis."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="ReviewProgress" Height="4" IsIndeterminate="True"
                         Visibility="Collapsed" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <ToggleButton x:Name="AllFilterButton" Content="Todos" Tag="All" IsChecked="True"
                          Style="{StaticResource SelectionChipStyle}" Click="Filter_Click"/>
            <ToggleButton x:Name="ErrorsFilterButton" Content="Erros" Tag="Errors"
                          Style="{StaticResource SelectionChipStyle}" Click="Filter_Click"/>
            <ToggleButton x:Name="WarningsFilterButton" Content="Avisos" Tag="Warnings"
                          Style="{StaticResource SelectionChipStyle}" Click="Filter_Click"/>
            <ToggleButton x:Name="InformationFilterButton" Content="Informações" Tag="Information"
                          Style="{StaticResource SelectionChipStyle}" Click="Filter_Click"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <ListBox x:Name="IssuesList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SeverityBadge" Padding="8,3" CornerRadius="10"
                                        Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Top">
                                    <TextBlock x:Name="SeverityText" Text="{Binding SeverityLabel}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Ir até" Tag="{Binding Issue}"
                                        Click="Navigate_Click" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,9,0,0">
                                    <TextBlock Text="{Binding LocationText}" Visibility="{Binding LocationVisibility}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding SectionText}" Visibility="{Binding SectionVisibility}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding MeterageText}" Visibility="{Binding MeterageVisibility}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static review:ReviewSeverity.Error}">
                                <Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static review:ReviewSeverity.Warning}">
                                <Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static review:ReviewSeverity.Info}">
                                <Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SeverityBadge" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" Visibility="Visible"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EmptyStateTitle" Text="Revisão ainda não executada"
                           FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateDescription"
                           Text="Clique em “Executar revisão” para analisar o relatório atual."
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="VisibleCountText" Grid.Row="5" Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
