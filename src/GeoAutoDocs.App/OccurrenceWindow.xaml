<Window x:Class="GeoAutoDocs.App.OccurrenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocorrência técnica" Width="1000" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#145B68"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="WindowTitle" Text="NOVA OCORRÊNCIA" FontSize="22" FontWeight="SemiBold" Foreground="#173C44"/>
            <TextBlock x:Name="SectionText" Margin="0,3,0,12" Foreground="#52676B"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormPanel" Margin="0,0,10,0">
                <Border Background="White" BorderBrush="#D4DDDF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="LOCALIZAÇÃO DA OCORRÊNCIA" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <RadioButton x:Name="PointRadio" Content="Metragem" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,0"/>
                            <RadioButton x:Name="RangeRadio" Content="Intervalo" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,0"/>
                            <RadioButton x:Name="EntireSectionRadio" Content="Todo o trecho" GroupName="Location" Checked="LocationMode_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="PointPanel" Orientation="Horizontal">
                            <TextBlock Text="Metragem:" VerticalAlignment="Center"/><TextBox x:Name="PointMeasurementBox" Width="120" Margin="8,0"/><TextBlock Text="m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="RangePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="Início:" VerticalAlignment="Center"/><TextBox x:Name="RangeStartBox" Width="110" Margin="8,0"/><TextBlock Text="m   Fim:" VerticalAlignment="Center"/><TextBox x:Name="RangeEndBox" Width="110" Margin="8,0"/><TextBlock Text="m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Ponto de referência (opcional)" Margin="0,10,0,3"/>
                        <TextBox x:Name="ReferencePointBox"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D4DDDF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ANOMALIAS — SELECIONE UMA OU MAIS" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedAnomaliesText" Text="Nenhuma selecionada" Foreground="#52676B" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="AnomaliesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox Content="{Binding Definition.Name}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Checked="AnomalySelection_Changed" Unchecked="AnomalySelection_Changed" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position}" IsEnabled="{Binding IsSelected}" Margin="8,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelected}" Visibility="{Binding Definition.AllowsCustomText, Converter={StaticResource BoolToVisibility}}" ToolTip="Descrição obrigatória para Outro"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D4DDDF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="OBSERVAÇÃO COMPLEMENTAR" FontWeight="SemiBold"/>
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="58" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <DockPanel><Button Content="Atualizar sugestão" DockPanel.Dock="Right" Click="PreviewDescription_Click"/><TextBlock Text="Descrição padronizada" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                        <TextBox x:Name="GeneratedDescriptionBox" IsReadOnly="True" Background="#EEF2F3" TextWrapping="Wrap" MinHeight="42" Margin="0,5"/>
                        <TextBlock Text="Descrição manual (opcional — substitui a padronizada no relatório)"/>
                        <TextBox x:Name="ManualDescriptionBox" AcceptsReturn="True" Height="58" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D4DDDF" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="EVIDÊNCIAS" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,7">
                            <ComboBox x:Name="PendingCaptureCombo" Width="300" DisplayMemberPath="Label"/>
                            <Button Content="+ Captura pendente" Click="AddPendingCapture_Click"/>
                            <Button Content="+ Imagem externa" Click="AddExternalImage_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="EvidenceList" ItemsSource="{Binding EvidenceItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinHeight="145">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D4DDDF" BorderThickness="1" CornerRadius="4" Padding="5" Margin="4" Width="170">
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Height="82" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="↑" Tag="{Binding Id}" Click="MoveEvidenceUp_Click"/><Button Content="↓" Tag="{Binding Id}" Click="MoveEvidenceDown_Click"/><Button Content="Remover" Tag="{Binding Id}" Click="RemoveEvidence_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Evidência é recomendada, mas a ocorrência pode ser salva sem imagem." Foreground="#9C6B16" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="SALVAR OCORRÊNCIA" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
