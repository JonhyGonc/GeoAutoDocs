<Window x:Class="GeoAutoDocs.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo projeto • GeoAutoDocs" Width="1040" Height="720" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="NOVO PROJETO" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Text="Crie o projeto e defina os dados padrão utilizados nos relatórios."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,16" Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DADOS DO PROJETO" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Nome do projeto "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock>
                                <TextBox x:Name="NameBox" MaxLength="180"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Os demais dados poderão ser alterados depois." Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="Somente o nome é obrigatório para criar o projeto." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DADOS PADRÃO DOS RELATÓRIOS" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Estes dados serão preenchidos automaticamente em novos relatórios e poderão ser alterados individualmente."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ClientBox"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="CnpjBox"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="AreaBox"/></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ContractBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="PurchaseOrderBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/>
                                <DockPanel><Button Content="Selecionar" DockPanel.Dock="Right" Margin="8,0,0,14" Click="SelectLogo_Click"/><TextBox x:Name="LogoBox" IsReadOnly="True"/></DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="O projeto será criado no armazenamento local seguro do GeoAutoDocs. O compartilhamento em rede continua disponível dentro do projeto."
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0"/>
                            <TextBlock Text="Armazenamento local automático" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" MinWidth="120"/>
            <Button Content="CRIAR PROJETO" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" MinWidth="180" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
