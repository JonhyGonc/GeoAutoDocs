<Window x:Class="GeoAutoDocs.App.ReportValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validação do relatório" Width="610" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Validação do relatório" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,12,0,14" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="ErrorsPanel" Background="#321B24" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="Erros bloqueantes" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/><TextBlock x:Name="ErrorsText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border x:Name="WarningsPanel" Background="#302817" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="7" Padding="14">
                    <StackPanel><TextBlock Text="Avisos" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock x:Name="WarningsText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Voltar e corrigir" IsCancel="True"/>
            <Button x:Name="GenerateButton" Content="Gerar relatório" Margin="8,0,0,0" IsDefault="True" Click="Generate_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
