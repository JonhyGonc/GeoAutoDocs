<Window x:Class="GeoAutoDocs.App.OccurrenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomalia" Width="1320" Height="840" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="AnomalyChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="WindowTitle" Text="←  Anomalias do trecho" Style="{StaticResource PageTitleTextStyle}" FontSize="22" Cursor="Hand" MouseLeftButtonUp="HeaderBack_Click"/><TextBlock x:Name="SectionText" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Center" MaxWidth="310"><TextBlock x:Name="DraftStatusText" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <Grid x:Name="FormPanel">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*" MinWidth="330"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1.08*" MinWidth="400"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Abrangência" Style="{StaticResource FieldLabelTextStyle}"/>
                    <WrapPanel Margin="0,0,0,13"><RadioButton x:Name="PointRadio" Content="Ponto" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,7"/><RadioButton x:Name="RangeRadio" Content="Intervalo" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,7"/><RadioButton x:Name="MultiPointRadio" Content="Múltiplos pontos" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,7"/><RadioButton x:Name="FromRadio" Content="A partir de" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,18,7"/><RadioButton x:Name="EntireSectionRadio" Content="Todo o trecho" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,0,7"/></WrapPanel>
                    <TextBlock Text="Metragem" Style="{StaticResource FieldLabelTextStyle}"/>
                    <StackPanel x:Name="PointPanel" Orientation="Horizontal" Margin="0,0,0,14"><TextBox x:Name="PointMeasurementBox" Width="120" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" TextChanged="DraftFieldChanged" KeyDown="PointMeasurementBox_KeyDown"/><TextBlock Text="m" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                    <StackPanel x:Name="RangePanel" Visibility="Collapsed" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="De (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="RangeStartBox" TextChanged="DraftFieldChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Até (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="RangeEndBox" TextChanged="DraftFieldChanged"/></StackPanel></Grid></StackPanel>
                    <StackPanel x:Name="MultiPointPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <DockPanel><Button Content="+ Adicionar" DockPanel.Dock="Right" Click="AddMultiPoint_Click" Margin="8,0,0,0"/><TextBox x:Name="MultiPointInputBox" FontSize="16" FontWeight="SemiBold" TextChanged="DraftFieldChanged" KeyDown="MultiPointInputBox_KeyDown" ToolTip="Informe uma metragem não negativa"/></DockPanel>
                        <ItemsControl ItemsSource="{Binding MultiPointItems}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,5"><DockPanel><Button Content="×" DockPanel.Dock="Right" Tag="{Binding Id}" Click="RemoveMultiPoint_Click" Padding="5,1" Margin="8,0,0,0" ToolTip="Remover metragem"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Consolas"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Adicione pelo menos duas metragens distintas; a lista é ordenada automaticamente." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="FromPanel" Visibility="Collapsed" Margin="0,0,0,14"><TextBlock Text="Metragem inicial (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="FromMeasurementBox" Width="120" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold" TextChanged="DraftFieldChanged"/></StackPanel>

                    <TextBlock Text="Tipo de anomalia" Style="{StaticResource FieldLabelTextStyle}"/>
                    <ItemsControl x:Name="FrequentAnomaliesList" Margin="0,0,0,5"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Definition.Name}" Style="{StaticResource AnomalyChipStyle}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Checked="AnomalySelection_Changed" Unchecked="AnomalySelection_Changed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Outra anomalia (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="CustomAnomalyBox" ToolTip="Descreva outra anomalia não listada" TextChanged="DraftFieldChanged" Margin="0,0,0,11"/>
                    <TextBlock x:Name="SelectedAnomaliesText" Text="Nenhuma selecionada" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="QuickAnomalyPositionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,6" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AnomalyPosition_Changed" Margin="0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <TextBlock Text="Observação (opcional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,7,0,0"/><TextBox x:Name="NotesBox" TextWrapping="Wrap" MinHeight="48" MaxHeight="72" AcceptsReturn="True" Margin="0,0,0,11" TextChanged="DraftFieldChanged"/>
                    <CheckBox x:Name="InterruptedRecordingCheck" Content="Esta anomalia interrompeu a filmagem" Margin="0,0,0,8" Checked="LivePreview_Changed" Unchecked="LivePreview_Changed"/>
                    <CheckBox x:Name="SevereAnomalyCheck" Content="Anomalia grave" Foreground="#FF5A5F" FontWeight="SemiBold" Margin="0,0,0,12" Checked="LivePreview_Changed" Unchecked="LivePreview_Changed"/>
                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Prévia no relatório" FontWeight="SemiBold"/><TextBlock x:Name="ReportPreviewText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>

                    <DockPanel Margin="0,2,0,8"><Button Content="+  Adicionar imagem" DockPanel.Dock="Right" Click="ToggleImageMenu_Click"/><TextBlock Text="Imagens adicionais (opcional)" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                    <Border x:Name="AddImageMenuPanel" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><ComboBox x:Name="PendingCaptureCombo" DisplayMemberPath="Label"/><WrapPanel><Button Content="Captura pendente" Click="AddPendingCapture_Click"/><Button Content="Imagem do computador" Click="AddExternalImage_Click"/></WrapPanel></StackPanel></Border>
                    <ListBox x:Name="AdditionalEvidenceList" BorderThickness="0" MaxHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="5" Margin="0,0,7,7" Width="112"><StackPanel><Image Source="{Binding Thumbnail}" Height="70" Stretch="Uniform"/><Button Content="Remover" Tag="{Binding Id}" Click="RemoveEvidence_Click" Padding="5" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>

                    <Expander x:Name="AdvancedDetailsExpander" Header="Mais detalhes" Margin="0,6,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="Ponto de referência (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReferencePointBox" TextChanged="DraftFieldChanged"/><ItemsControl x:Name="AdvancedAnomaliesList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Margin="0,8,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Orientations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Orientation}" Visibility="{Binding Definition.SupportsOrientation, Converter={StaticResource BoolToVisibility}}" SelectionChanged="AnomalyPosition_Changed"/><TextBox Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Extensão aproximada (m)" Visibility="{Binding Definition.SupportsExtension, Converter={StaticResource BoolToVisibility}}" TextChanged="DraftFieldChanged"/><TextBox Text="{Binding Dimension, UpdateSourceTrigger=PropertyChanged}" ToolTip="Dimensão" Visibility="{Binding Definition.SupportsDimension, Converter={StaticResource BoolToVisibility}}" TextChanged="DraftFieldChanged"/><ComboBox ItemsSource="{Binding Conditions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Condition}" Visibility="{Binding Definition.SupportsCondition, Converter={StaticResource BoolToVisibility}}" SelectionChanged="AnomalyPosition_Changed"/><ComboBox ItemsSource="{Binding InfiltrationConditions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InfiltrationCondition}" Visibility="{Binding Definition.SupportsInfiltrationCondition, Converter={StaticResource BoolToVisibility}}" SelectionChanged="AnomalyPosition_Changed"/><TextBox Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Percentual estimado" Visibility="{Binding Definition.SupportsPercentage, Converter={StaticResource BoolToVisibility}}" TextChanged="DraftFieldChanged"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Texto complementar" Visibility="{Binding Definition.SupportsComplementaryText, Converter={StaticResource BoolToVisibility}}" TextChanged="DraftFieldChanged"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
                    <ItemsControl x:Name="AdditionalAnomaliesList" Visibility="Collapsed"/><ItemsControl x:Name="CustomAnomalyFieldsList" Visibility="Collapsed"/><Button x:Name="MoreAnomaliesButton" Visibility="Collapsed"/><Border x:Name="AdditionalAnomaliesPanel" Visibility="Collapsed"><TextBox x:Name="AnomalySearchBox" TextChanged="AnomalySearchBox_TextChanged"/></Border>
                    <ListBox x:Name="EvidenceList" Visibility="Collapsed" ItemsSource="{Binding EvidenceItems}"/>
                    <TextBox x:Name="GeneratedDescriptionBox" Visibility="Collapsed"/><TextBox x:Name="ManualDescriptionBox" Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                    <TextBlock Text="Imagem da anomalia" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                    <Border Background="#02070B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True" MinHeight="390">
                        <Grid>
                            <Image x:Name="PrimaryImage" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel x:Name="PrimaryImageEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Nenhuma imagem vinculada" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/></StackPanel>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="5" Background="#D90A1923"><TextBlock x:Name="PrimaryMeterageText" Text="Metragem não informada" FontFamily="Consolas" FontWeight="SemiBold"/></Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="5" Background="#D90A1923"><TextBlock x:Name="PrimaryTimestampText" Text="Sem timestamp" FontFamily="Consolas"/></Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="9,5" CornerRadius="5" Background="#D90A1923"><TextBlock x:Name="PrimaryVideoText" Text="Origem não informada" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340"/></Border>
                        </Grid>
                    </Border>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="←  1s" Click="PreviousFrame_Click" ToolTip="Voltar um segundo e refazer o frame"/><Button Content="1s  →" Click="NextFrame_Click" ToolTip="Avançar um segundo e refazer o frame"/><Button x:Name="ViewOriginalButton" Content="Ver original (100%)" Click="ViewOriginal_Click" ToolTip="Abrir o PNG original sem ampliação ou redução"/></StackPanel><Button x:Name="RecaptureButton" Grid.Column="1" Content="Refazer captura" Click="RecaptureFrame_Click"/></Grid>
                    <TextBlock x:Name="FrameHelpText" Text="O frame principal foi extraído diretamente do vídeo no timestamp exibido." Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FooterHintText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="LeavePendingButton" Content="Manter captura pendente" HorizontalAlignment="Left" Margin="0,0,0,0" Click="LeavePending_Click" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Salvar anomalia" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" MinWidth="150"/><Button x:Name="SaveAndNextButton" Visibility="Collapsed" Click="SaveAndNext_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
