<Window x:Class="GeoAutoDocs.App.OccurrenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomalia" Width="680" Height="820" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="AnomalyChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18" MaxWidth="900" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="WindowTitle" Text="Nova anomalia" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/><TextBlock x:Name="SectionText" Margin="0,3,0,12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top" MaxWidth="260"><TextBlock x:Name="DraftStatusText" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,7,0">
            <StackPanel x:Name="FormPanel">
                <TextBlock Text="Abrangência" Style="{StaticResource FieldLabelTextStyle}"/><WrapPanel Margin="0,0,0,9"><RadioButton x:Name="PointRadio" Content="Ponto" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,16,0"/><RadioButton x:Name="RangeRadio" Content="Intervalo" GroupName="Location" Checked="LocationMode_Changed" Margin="0,0,16,0"/><RadioButton x:Name="EntireSectionRadio" Content="Todo o trecho" GroupName="Location" Checked="LocationMode_Changed"/></WrapPanel>
                <TextBlock Text="Metragem" Style="{StaticResource FieldLabelTextStyle}"/>
                <StackPanel x:Name="PointPanel" Orientation="Horizontal" Margin="0,0,0,12"><TextBox x:Name="PointMeasurementBox" Width="150" FontSize="20" FontWeight="SemiBold" Margin="0,0,8,0" TextChanged="DraftFieldChanged" KeyDown="PointMeasurementBox_KeyDown"/><TextBlock Text="m" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                <StackPanel x:Name="RangePanel" Visibility="Collapsed" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Início (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="RangeStartBox" TextChanged="DraftFieldChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fim (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="RangeEndBox" TextChanged="DraftFieldChanged"/></StackPanel></Grid></StackPanel>

                <TextBlock Text="Anomalias" Style="{StaticResource SectionTitleTextStyle}" Margin="0,2,0,9"/>
                <ItemsControl x:Name="FrequentAnomaliesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Definition.Name}" Style="{StaticResource AnomalyChipStyle}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsFrequent, Converter={StaticResource BoolToVisibility}}" Checked="AnomalySelection_Changed" Unchecked="AnomalySelection_Changed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button x:Name="MoreAnomaliesButton" Content="+ Mais" Visibility="Collapsed" Click="ToggleMoreAnomalies_Click"/>
                <Border x:Name="AdditionalAnomaliesPanel" Visibility="Collapsed">
                    <StackPanel><TextBox x:Name="AnomalySearchBox" ToolTip="Buscar outros tipos" TextChanged="AnomalySearchBox_TextChanged" Margin="0,0,0,9"/><ItemsControl x:Name="AdditionalAnomaliesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Definition.Name}" Style="{StaticResource AnomalyChipStyle}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowInAdditionalList, Converter={StaticResource BoolToVisibility}}" Checked="AnomalySelection_Changed" Unchecked="AnomalySelection_Changed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <TextBlock Text="Outra anomalia (opcional)" Style="{StaticResource FieldLabelTextStyle}"/>
                <TextBox x:Name="CustomAnomalyBox" ToolTip="Descreva uma anomalia que não está na lista" TextChanged="DraftFieldChanged" Margin="0,0,0,10"/>
                <TextBlock x:Name="SelectedAnomaliesText" Text="Nenhuma selecionada" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <ItemsControl x:Name="QuickAnomalyPositionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="9,7" Margin="0,0,0,6" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AnomalyPosition_Changed"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl x:Name="CustomAnomalyFieldsList" Visibility="Collapsed"/>

                <TextBlock Text="Observação (opcional)" Style="{StaticResource FieldLabelTextStyle}"/>
                <TextBox x:Name="NotesBox" TextWrapping="Wrap" MinHeight="42" MaxHeight="78" AcceptsReturn="True" Margin="0,0,0,13" TextChanged="DraftFieldChanged"/>
                <CheckBox x:Name="InterruptedRecordingCheck" Content="Esta ocorrência interrompeu a filmagem" Margin="0,0,0,13" Checked="LivePreview_Changed" Unchecked="LivePreview_Changed"/>
                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,13"><StackPanel><TextBlock Text="Prévia no relatório" FontWeight="SemiBold"/><TextBlock x:Name="ReportPreviewText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>

                <DockPanel Margin="0,0,0,8"><Button Content="+" Width="38" MinWidth="38" Height="38" Padding="0" DockPanel.Dock="Right" Click="ToggleImageMenu_Click" ToolTip="Adicionar imagem"/><TextBlock Text="Imagens" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                <Border x:Name="AddImageMenuPanel" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="Adicionar imagem" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox x:Name="PendingCaptureCombo" DisplayMemberPath="Label"/><StackPanel Orientation="Horizontal"><Button Content="Captura pendente" Click="AddPendingCapture_Click"/><Button Content="Imagem do computador" Click="AddExternalImage_Click"/></StackPanel></StackPanel></Border>
                <ListBox x:Name="EvidenceList" ItemsSource="{Binding EvidenceItems}" BorderThickness="0" MinHeight="210" MaxHeight="460" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="7" Margin="0,0,9,9" Width="280"><StackPanel><Grid><Image Source="{Binding Thumbnail}" Height="180" Stretch="Uniform"/><TextBlock Text="★" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" Visibility="{Binding Evidence.IsPrimary, Converter={StaticResource BoolToVisibility}}"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="←" MinWidth="38" Tag="{Binding Id}" Click="MoveEvidenceUp_Click" ToolTip="Mover para esquerda"/><Button Content="→" MinWidth="38" Tag="{Binding Id}" Click="MoveEvidenceDown_Click" ToolTip="Mover para direita"/><Button Content="×" MinWidth="38" Foreground="{StaticResource DangerBrush}" Tag="{Binding Id}" Click="RemoveEvidence_Click" ToolTip="Remover"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>

                <Expander x:Name="AdvancedDetailsExpander" Header="Mais detalhes" Margin="0,8,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Ponto de referência (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReferencePointBox" TextChanged="DraftFieldChanged"/>
                        <ItemsControl x:Name="AdvancedAnomaliesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="11" Margin="0,0,0,8" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Visibility="{Binding Definition.SupportsPosition, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Posição" Style="{StaticResource FieldLabelTextStyle}"/><ComboBox ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AnomalyPosition_Changed"/></StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding Definition.SupportsOrientation, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Orientação" Style="{StaticResource FieldLabelTextStyle}"/><ComboBox ItemsSource="{Binding Orientations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Orientation}"/></StackPanel>
                            <StackPanel Grid.Row="1" Visibility="{Binding Definition.SupportsExtension, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Extensão (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Visibility="{Binding Definition.SupportsDimension, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Dimensão" Style="{StaticResource FieldLabelTextStyle}"/><TextBox Text="{Binding Dimension, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="2" Visibility="{Binding Definition.SupportsCondition, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Condição" Style="{StaticResource FieldLabelTextStyle}"/><ComboBox ItemsSource="{Binding Conditions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Condition}"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Visibility="{Binding Definition.SupportsInfiltrationCondition, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Infiltração" Style="{StaticResource FieldLabelTextStyle}"/><ComboBox ItemsSource="{Binding InfiltrationConditions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InfiltrationCondition}"/></StackPanel>
                            <StackPanel Grid.Row="3" Visibility="{Binding Definition.SupportsPercentage, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Percentual (%)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Característica específica" Style="{StaticResource FieldLabelTextStyle}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Expander>

                <TextBox x:Name="GeneratedDescriptionBox" Visibility="Collapsed"/>
                <TextBox x:Name="ManualDescriptionBox" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="FooterHintText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="LeavePendingButton" Grid.Row="1" Content="Deixar captura pendente" HorizontalAlignment="Left" Margin="4" Click="LeavePending_Click" Visibility="Collapsed"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Salvar" Click="Save_Click"/><Button x:Name="SaveAndNextButton" Content="Salvar e continuar" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="SaveAndNext_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
