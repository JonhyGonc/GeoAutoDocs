<Window x:Class="GeoAutoDocs.App.CustomSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etapa personalizada" Height="480" Width="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Título (opcional)"/><TextBox x:Name="TitleBox"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="Texto"/><TextBox x:Name="TextBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <DockPanel Grid.Row="2">
            <Button Content="Adicionar imagens" DockPanel.Dock="Top" HorizontalAlignment="Left" Click="AddImages_Click"/>
            <ListBox x:Name="ImagesList" Margin="0,8,0,8"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True"/>
            <Button Content="Adicionar" IsDefault="True" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
