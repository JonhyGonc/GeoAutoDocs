<Window x:Class="GeoAutoDocs.App.AnomalyCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo de anomalias" Width="980" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <Button x:Name="NewButton" Content="+ Nova anomalia" Style="{StaticResource PrimaryButtonStyle}"
                    DockPanel.Dock="Right" Click="New_Click"/>
            <StackPanel>
                <TextBlock Text="Catálogo de anomalias" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Crie uma anomalia e defina livremente o texto que aparecerá no relatório."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" ToolTip="Pesquisar anomalias" TextChanged="Search_TextChanged" Margin="0,0,0,10"/>
            <ListBox x:Name="CatalogList" Grid.Row="1" SelectionChanged="Catalog_SelectionChanged" DisplayMemberPath="Name"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="UpButton" Content="Mover para cima" ToolTip="Mover para cima" Click="Up_Click"/>
                <Button x:Name="DownButton" Content="Mover para baixo" ToolTip="Mover para baixo" Click="Down_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditorPanel">
                <TextBlock Text="Nome da anomalia" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Margin="0,6,0,18" MinHeight="40"/>

                <TextBlock Text="Texto usado no relatório" FontWeight="SemiBold"/>
                <TextBox x:Name="TemplateBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,6,0,6"
                         TextChanged="Template_TextChanged"/>
                <TextBlock Text="Escreva o texto completo exatamente como deseja. As variáveis são opcionais."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>

                <TextBlock Text="Prévia do texto" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="14" MinHeight="72">
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <Expander Header="Opções avançadas (opcional)" IsExpanded="False" Margin="0,18,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Use somente se o texto precisar receber informações escolhidas no cadastro da ocorrência."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <CheckBox x:Name="PositionCheck" Content="Posição" Margin="0,0,18,8"/>
                            <CheckBox x:Name="OrientationCheck" Content="Orientação" Margin="0,0,18,8"/>
                            <CheckBox x:Name="ExtensionCheck" Content="Extensão" Margin="0,0,18,8"/>
                            <CheckBox x:Name="DimensionCheck" Content="Dimensão" Margin="0,0,18,8"/>
                            <CheckBox x:Name="ConditionCheck" Content="Condição" Margin="0,0,18,8"/>
                            <CheckBox x:Name="InfiltrationCheck" Content="Condição de infiltração" Margin="0,0,18,8"/>
                            <CheckBox x:Name="PercentageCheck" Content="Percentual" Margin="0,0,18,8"/>
                            <CheckBox x:Name="ComplementCheck" Content="Texto complementar" Margin="0,0,18,8"/>
                        </WrapPanel>
                        <TextBlock Text="Variáveis disponíveis" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="Use: {nome}  {posicao}  {orientacao}  {extensao}  {dimensao}  {condicao}  {condicaoInfiltracao}  {percentual}  {textoComplementar}"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="ActiveButton" Click="Active_Click"/>
                    <Button x:Name="SaveButton" Content="Salvar alterações" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
