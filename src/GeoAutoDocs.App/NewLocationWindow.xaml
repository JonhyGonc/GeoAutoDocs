<Window x:Class="GeoAutoDocs.App.NewLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo local" Width="680" Height="340" MinWidth="520" MinHeight="300"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="26,22" MaxWidth="760" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Novo local" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/>
            <TextBlock Text="Informe um nome para organizar os trechos da inspeção."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,18" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource FieldLabelTextStyle}">
                <Run Text="Nome do local "/>
                <Run Text="*" Foreground="{StaticResource DangerBrush}"/>
            </TextBlock>
            <TextBox x:Name="NameBox" MaxLength="180"/>
            <TextBlock x:Name="ValidationText" Text="O nome do local é obrigatório."
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock Text="O local será adicionado ao projeto atual."
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True"/>
                <Button Content="Adicionar local" IsDefault="True" MinWidth="150"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
