<Window x:Class="GeoAutoDocs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GeoAutoDocs" Icon="Assets/GeoAutoDocs.ico" Height="900" Width="1480" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SelectionChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CleanContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#20384C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#132536"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="5">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource BorderBrush}"/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Shared application chrome: always visible in Projects and project workspaces. -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="5">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentGlowBrush}"
                        BorderBrush="#4D00B4D8" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="GeoAutoDocs" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="v2.0" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0" Panel.ZIndex="4">
            <StackPanel Margin="0,8,0,0">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentGlowBrush}"
                        BorderBrush="#4D00B4D8" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="SidebarProjectsButton" Style="{StaticResource SidebarItemActiveStyle}" Click="SidebarProjects_Click" ToolTip="Projetos">
                    <StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Projetos" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="SidebarInspectionButton" Style="{StaticResource SidebarItemStyle}" Click="SidebarInspection_Click" IsEnabled="False" ToolTip="Inspeção">
                    <StackPanel><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Inspeção" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="SidebarReportsButton" Style="{StaticResource SidebarItemStyle}" Click="SidebarReports_Click" IsEnabled="False" ToolTip="Relatórios">
                    <StackPanel><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Relatórios" FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="SidebarConfigButton" Style="{StaticResource SidebarItemStyle}" IsEnabled="False" ToolTip="Configurações">
                    <StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Config." FontSize="9" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="HomeShell" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="13" Background="#123C66" Margin="0,0,9,0"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#55B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="GeoAutoDocs" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid x:Name="ProjectsView" Margin="28,20,26,12" MaxWidth="1920" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid x:Name="ProjectsHeaderGrid">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ProjectsSearchColumn" Width="390"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="ProjectsHeaderTitlePanel">
                            <TextBlock Text="Projetos" Style="{StaticResource PageTitleTextStyle}"/>
                            <TextBlock Text="Gerencie seus projetos de vídeo inspeção" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid x:Name="ProjectsHeaderSearchPanel" Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="15,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False"/>
                            <TextBox x:Name="ProjectsSearchBox" Style="{StaticResource SearchBoxStyle}" ToolTip="Pesquisar projetos por nome ou cliente" TextChanged="ProjectsSearchBox_TextChanged" Margin="0"/>
                            <TextBlock x:Name="ProjectsSearchHint" Text="Pesquisar projetos..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="NewProjectTopButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Height="34" Margin="0" Click="NewProject_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Novo projeto"/></StackPanel>
                        </Button>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,20">
                        <Border x:Name="TotalProjectsCard" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="TotalProjectsIconColumn" Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentGlowBrush}"><Path Data="{StaticResource FolderIconGeometry}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Width="17" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="TotalProjectsLabel" Text="Total de projetos" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TotalProjectsMetric" Text="0" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="TotalProjectsDetail" Text="Nenhum projeto cadastrado" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="TotalReportsCard" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="TotalReportsIconColumn" Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SuccessDimBrush}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="TotalReportsLabel" Text="Relatórios" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TotalReportsMetric" Text="0" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="TotalReportsDetail" Text="Nenhum relatório" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="InProgressReportsCard" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="InProgressReportsIconColumn" Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource WarningDimBrush}"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="InProgressReportsLabel" Text="Em andamento" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="InProgressReportsMetric" Text="0" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="InProgressReportsDetail" Text="Nenhum em andamento" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="SharedProjectsCard" Style="{StaticResource StatCardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SharedProjectsIconColumn" Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PurpleDimBrush}"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="SharedProjectsLabel" Text="Compartilhados" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SharedProjectsMetric" Text="0" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="SharedProjectsDetail" Text="Somente projetos locais" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid x:Name="ProjectsListPanel">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Projetos cadastrados" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                            <ListView x:Name="ProjectsList" Grid.Row="1" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,11"/><Setter Property="Background" Value="Transparent"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource ProjectCardStyle}" Tag="{Binding Id}" MouseLeftButtonUp="ProjectCard_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="7" Background="{StaticResource AccentGlowBrush}" HorizontalAlignment="Left"><Path Data="{StaticResource FolderIconGeometry}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Width="18" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Left" Margin="8,0,0,0">
                                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}"><Style.Triggers><DataTrigger Binding="{Binding StorageKind}" Value="Shared"><Setter Property="Background" Value="{StaticResource PurpleDimBrush}"/><Setter Property="BorderBrush" Value="#40A855F7"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock x:Name="ProjectStorageBadge" Text="Local" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DefaultClient}"/><Style.Triggers><DataTrigger Binding="{Binding DefaultClient}" Value=""><Setter Property="Text" Value="Cliente não informado"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger><DataTrigger Binding="{Binding DefaultClient}" Value="{x:Null}"><Setter Property="Text" Value="Cliente não informado"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Reports.Count, StringFormat={}{0} relatório(s)}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Abrir" Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding Id}" Click="OpenProject_Click" MinWidth="58" Margin="0,0,7,0"/>
                                                <Button Content="&#xE712;" Style="{StaticResource IconButtonStyle}" Tag="{Binding Id}" Click="ProjectActions_Click" ToolTip="Ações do projeto" Margin="0">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource CleanContextMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Renomear" Style="{StaticResource CleanContextMenuItemStyle}" Tag="{Binding Id}" Click="RenameProject_Click"/>
                                                            <Separator Style="{StaticResource CleanContextMenuSeparatorStyle}"/>
                                                            <MenuItem Header="Excluir" Style="{StaticResource CleanContextMenuItemStyle}" Tag="{Binding Id}" Click="DeleteProject_Click" Foreground="{StaticResource DangerBrush}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StorageKind}" Value="Shared">
                                            <Setter TargetName="ProjectStorageBadge" Property="Text" Value="Compartilhado"/>
                                            <Setter TargetName="ProjectStorageBadge" Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Border x:Name="ProjectsEmptyState" Visibility="Collapsed" Background="#0E1C2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" MinHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border Width="88" Height="88" CornerRadius="44" Background="#142536" Margin="0,0,0,22"><Path Data="{StaticResource FolderIconGeometry}" Stroke="#71859A" StrokeThickness="2" Width="42" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock x:Name="ProjectsEmptyTitle" Text="Nenhum projeto criado" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ProjectsEmptyDescription" Text="Crie seu primeiro projeto para começar." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" TextAlignment="Center"/>
                                    <Button x:Name="ProjectsEmptyAction" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,22,0,0" Click="NewProject_Click" MinWidth="158">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Novo projeto"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="24,18" Margin="0,24,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="#102F4C"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#55B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Armazenamento" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="StorageValueText" Text="Local" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/><TextBlock x:Name="StorageDetailText" Text="Projetos salvos neste computador" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="18,0"/>
                            <Grid Grid.Column="2" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="#302B19"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Segurança" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="SecurityValueText" Text="Salvamento automático ativo" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/><TextBlock x:Name="SecurityDetailText" Text="Alterações são persistidas automaticamente" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                            <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="18,0"/>
                            <Grid Grid.Column="4" Margin="24,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="#102F4C"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Último backup" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="BackupValueText" Text="Nunca realizado" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/><TextBlock x:Name="BackupDetailText" Text="Nenhum backup disponível" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="NewProjectView" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="10">
                    <Border Style="{StaticResource DialogStyle}" Width="560" MaxHeight="730" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButtonStyle}"
                                        FontSize="18" Width="32" Height="28" Margin="0" Click="CancelNewProject_Click"/>
                                <StackPanel><TextBlock Text="Novo projeto" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Defina os dados principais do projeto." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,9"><TextBlock Text="IDENTIFICAÇÃO" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/><Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/></DockPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="NOME DO PROJETO "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock>
                                    <TextBox x:Name="NewProjectNameBox" MaxLength="180"/>

                                    <DockPanel Margin="0,8,0,9"><TextBlock Text="CLIENTE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/><Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/></DockPanel>
                                    <TextBlock Text="CLIENTE" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectClientBox"/>
                                    <TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectCnpjBox" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <TextBlock Text="ÁREA / LOCALIZAÇÃO" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectAreaBox"/>
                                    <TextBlock Text="LOGO DO CLIENTE" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="NewProjectLogoPreview" Width="50" Height="38" Stretch="Uniform"/><TextBlock x:Name="NewProjectLogoStatus" Grid.Column="1" Text="Nenhuma imagem selecionada" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="Selecionar" Style="{StaticResource GhostButtonStyle}" Click="SelectNewProjectLogo_Click"/><TextBox x:Name="NewProjectLogoBox" Visibility="Collapsed"/></Grid></Border>

                                    <DockPanel Margin="0,8,0,9"><TextBlock Text="CONTRATO" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/><Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/></DockPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="CONTRATO" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectContractBox" FontFamily="{StaticResource MonoFont}" FontSize="12"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="PEDIDO DE COMPRA" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectPurchaseOrderBox" FontFamily="{StaticResource MonoFont}" FontSize="12"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="Somente o nome é obrigatório." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" Click="CancelNewProject_Click" MinWidth="90"/><Button Content="Criar projeto" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Click="CreateProject_Click"/></StackPanel></Grid>
