                            <StackPanel Grid.Row="1"><TextBlock Text="Ponto inicial (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionStartBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Ponto final (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionEndBox"/></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Diâmetro (mm, opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionDiameterBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Referência (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionReferenceBox"/></StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3"><TextBlock Text="Descrição (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionDescriptionBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/></StackPanel>
                        </Grid></ScrollViewer>
                        <Grid Grid.Row="2"><TextBlock x:Name="NewSectionValidationText" Text="Campos opcionais podem permanecer vazios." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="CancelInspectionForm_Click"/><Button x:Name="CreateSectionButton" Content="Criar trecho" Style="{StaticResource PrimaryButtonStyle}" Click="CreateSection_Click"/></StackPanel></Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ProjectDialogOverlay" Visibility="Collapsed" Background="#C2000000" Panel.ZIndex="40">
            <Border Style="{StaticResource DialogStyle}" Width="500" MaxWidth="500" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid x:Name="RenameProjectDialogPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Renomear projeto" Style="{StaticResource PageTitleTextStyle}" FontSize="21"/>
                            <TextBlock Text="Atualize o nome usado para identificar este projeto." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,22,0,4">
                            <TextBlock Text="Novo nome" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox x:Name="RenameProjectNameBox" MaxLength="180"/>
                            <TextBlock x:Name="RenameProjectValidationText" Text="O nome do projeto é obrigatório." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" Margin="0,-5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="CancelProjectDialog_Click" MinWidth="104"/>
                            <Button Content="Renomear" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmRenameProject_Click" MinWidth="112"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DeleteProjectDialogPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Excluir projeto?" Style="{StaticResource PageTitleTextStyle}" FontSize="21"/>
                            <TextBlock x:Name="DeleteProjectMessage" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#2D1B21" BorderBrush="#63323B" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,20,0,0">
                            <TextBlock Text="Esta ação remove o projeto e seus dados persistidos." Foreground="#F2A8AE" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="CancelProjectDialog_Click" MinWidth="104"/>
                            <Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Click="ConfirmDeleteProject_Click" MinWidth="104"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
