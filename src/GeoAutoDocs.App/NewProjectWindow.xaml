<Window x:Class="GeoAutoDocs.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo projeto • GeoAutoDocs" Width="980" Height="650" MinWidth="820" MinHeight="590"
        ResizeMode="CanResize" SizeToContent="Manual" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Novo projeto" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Defina os dados principais. Eles serão herdados automaticamente pelos relatórios." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,0"/></StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Nome do projeto "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock><TextBox x:Name="NameBox" MaxLength="180"/></StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="Dados do projeto" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,14"/>
            <StackPanel Grid.Row="2"><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ClientBox"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="CnpjBox"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="AreaBox"/></StackPanel>
            <StackPanel Grid.Row="3"><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ContractBox"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="PurchaseOrderBox"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="4"><TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="LogoPreview" Width="54" Height="45" Stretch="Uniform"/><TextBlock x:Name="LogoStatus" Grid.Column="1" Text="Nenhuma imagem" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/><Button Grid.Column="2" Content="Selecionar" Click="SelectLogo_Click"/><TextBox x:Name="LogoBox" Visibility="Collapsed"/></Grid></Border></StackPanel>
        </Grid>

        <Grid Grid.Row="2"><TextBlock Text="Somente o nome é obrigatório." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" MinWidth="110"/><Button Content="Criar projeto" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" MinWidth="160" Click="Create_Click"/></StackPanel></Grid>
    </Grid>
</Window>
