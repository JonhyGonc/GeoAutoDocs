<Window x:Class="GeoAutoDocs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GeoAutoDocs" Height="900" Width="1480" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SelectionChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ProjectsView" Margin="34,28" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Projetos" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Gerencie seus projetos de vídeo inspeção" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,24,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                <Button x:Name="NewProjectTopButton" Content="+  Novo projeto" Style="{StaticResource PrimaryButtonStyle}" MinWidth="190" Margin="0" Click="NewProject_Click"/>
                <Grid Grid.Column="2">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="13,0,0,13" Panel.ZIndex="1" IsHitTestVisible="False"/>
                    <TextBox x:Name="ProjectsSearchBox" Padding="40,9,12,9" Margin="0" ToolTip="Pesquisar projetos por nome ou cliente" TextChanged="ProjectsSearchBox_TextChanged"/>
                    <TextBlock x:Name="ProjectsSearchHint" Text="Pesquisar projetos..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="40,0,0,13" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource BorderBrush}"/>
            <Grid Grid.Row="3" Margin="0,14,0,0"><ListView x:Name="ProjectsList" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,9"/><Setter Property="Background" Value="Transparent"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="17" Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="9" Background="#123A53" HorizontalAlignment="Left"><Path Data="M 3,7 L 10,7 L 13,10 L 25,10 L 25,22 L 3,22 Z" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Width="28" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DefaultClient, TargetNullValue='Cliente não informado'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding Reports.Count, StringFormat={}{0} relatório(s)}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Abrir" Tag="{Binding Id}" Click="OpenProject_Click" Foreground="{StaticResource PrimaryBrush}"/><Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}" Tag="{Binding Id}" Click="RenameProject_Click" ToolTip="Renomear projeto"/><Button Content="&#xE74D;" Style="{StaticResource DangerButtonStyle}" FontFamily="Segoe MDL2 Assets" Tag="{Binding Id}" Click="DeleteProject_Click" ToolTip="Excluir projeto"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
                <StackPanel x:Name="ProjectsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="ProjectsEmptyTitle" Text="Nenhum projeto criado" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/><TextBlock x:Name="ProjectsEmptyDescription" Text="Crie seu primeiro projeto para iniciar." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/><Button x:Name="ProjectsEmptyAction" Content="+  Novo projeto" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="NewProject_Click"/></StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="NewProjectView" Visibility="Collapsed" Margin="34,24" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <Button Content="←  Projetos" HorizontalAlignment="Left" Margin="0,0,0,18" Click="CancelNewProject_Click"/>
                <TextBlock Text="Novo projeto" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Defina os dados principais. Eles serão herdados automaticamente pelos relatórios." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <Grid Margin="0,24,0,16" MaxWidth="1080" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Nome do projeto "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock><TextBox x:Name="NewProjectNameBox" MaxLength="180"/></StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Dados do projeto" Style="{StaticResource SectionTitleTextStyle}" Margin="0,18,0,14"/>
                    <StackPanel Grid.Row="2"><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectClientBox"/><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectAreaBox"/><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectPurchaseOrderBox"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectCnpjBox"/><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewProjectContractBox"/><TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="NewProjectLogoPreview" Width="54" Height="45" Stretch="Uniform"/><TextBlock x:Name="NewProjectLogoStatus" Grid.Column="1" Text="Sem imagem" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="Selecionar" Click="SelectNewProjectLogo_Click"/><TextBox x:Name="NewProjectLogoBox" Visibility="Collapsed"/></Grid></Border></StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2"><TextBlock Text="Somente o nome é obrigatório." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="CancelNewProject_Click" MinWidth="110"/><Button Content="Criar projeto" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160" Click="CreateProject_Click"/></StackPanel></Grid>
        </Grid>

        <Grid x:Name="EditorView" Visibility="Collapsed" Margin="24,18,28,14" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="←  Projetos" Margin="0,0,16,0" VerticalAlignment="Center" Click="Back_Click"/>
                <StackPanel Grid.Column="1"><TextBlock x:Name="ProjectTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="23" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProjectClientSummary" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StorageStatus" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/><Button x:Name="ShareProjectButton" Content="Compartilhar" Click="ShareProject_Click"/></StackPanel>
            </Grid>

            <TabControl x:Name="ReportEditorTabs" Grid.Row="1" Margin="0">
                <TabItem x:Name="OverviewTab" Header="Visão geral">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                        <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                            <TextBlock Text="Visão geral" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
                            <TextBlock Text="Acompanhe o projeto e continue de onde parou." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="OverviewProjectName" Style="{StaticResource SectionTitleTextStyle}" FontSize="19"/>
                                    <TextBlock x:Name="OverviewClientName" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,18"/>
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,18,0"><TextBlock x:Name="OverviewReportsCount" FontSize="22" FontWeight="Bold"/><TextBlock Text="Relatórios" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                        <StackPanel Margin="0,0,18,0"><TextBlock x:Name="OverviewSectionsCount" FontSize="22" FontWeight="Bold"/><TextBlock Text="Trechos" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                        <StackPanel Margin="0,0,18,0"><TextBlock x:Name="OverviewOccurrencesCount" FontSize="22" FontWeight="Bold"/><TextBlock Text="Anomalias" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="OverviewUpdatedAt" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="Última alteração" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Continuar inspeção" Style="{StaticResource PrimaryButtonStyle}" Click="ContinueInspection_Click"/>
                                <Button Content="Novo relatório" Click="OverviewNewReport_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="InspectionsTab" Header="Inspeção">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,10,8,0" MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="300"/><RowDefinition Height="Auto"/><RowDefinition Height="1.55*" MinHeight="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Local" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LocationsList" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="LocationsList_SelectionChanged" Margin="0"/>
                                <Button x:Name="AddLocationButton" Grid.Column="2" Content="+ Local" MinWidth="72" Margin="4,0,0,0" Click="AddLocation_Click" ToolTip="Novo local"/>
                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Trecho" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SectionsList" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="SectionsList_SelectionChanged" Margin="0"/>
                                <Button x:Name="AddSectionButton" Grid.Column="2" Content="+ Trecho" MinWidth="82" Margin="4,0,0,0" Click="AddSection_Click" ToolTip="Novo trecho"/>
                            </Grid>
                            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Vídeo" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="VideosList" Grid.Column="1" SelectionChanged="VideosList_SelectionChanged" Margin="0"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Availability}" Foreground="{Binding StatusColor}" FontSize="10"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <Button x:Name="AddVideoButton" Grid.Column="2" Content="+ Vídeo" MinWidth="76" Margin="4,0" Click="AddVideo_Click" ToolTip="Adicionar vídeo"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="RelocateVideoButton" Content="Localizar" Margin="0" Click="RelocateVideo_Click" IsEnabled="False" ToolTip="Localizar arquivo ausente"/><Button x:Name="RemoveVideoButton" Content="Remover" Margin="4,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="RemoveVideo_Click" IsEnabled="False"/></StackPanel>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="1" Background="#030608" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <vlc:VideoView x:Name="VideoView">
                                <Grid>
                                    <StackPanel x:Name="VideoEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="VideoMessage" Text="Escolha um trecho e um vídeo para iniciar." Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="EmptyVideoButton" Content="+ Adicionar vídeo" HorizontalAlignment="Center" Margin="0,12,0,0" Click="AddVideo_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border x:Name="CapturePreviewPanel" Background="#F50D1924" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="8" Padding="18" Margin="18" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1080">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel><Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right" Click="RetakeCapture_Click" ToolTip="Fechar preview"/><StackPanel><TextBlock Text="Conferir captura" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Cadastre a anomalia agora ou deixe a imagem pendente para revisar depois." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
                                            <Image x:Name="CapturePreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,10"/>
                                            <TextBlock x:Name="CapturePreviewTimestamp" Grid.Row="2" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="Refazer captura" Click="RetakeCapture_Click"/><Button Content="Deixar pendente" Click="AcceptCapture_Click"/><Button Content="Cadastrar anomalia" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Abre o cadastro com esta imagem, vídeo e momento associados." Click="CreateOccurrenceFromCapture_Click"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </vlc:VideoView>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,8,0,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><Button Content="−5s" Click="Back5_Click"/><Button Content="−1s" Click="Back1_Click"/><Button x:Name="PlayPauseButton" Content="▶" Width="48" Click="PlayPause_Click"/><Button Content="+1s" Click="Forward1_Click"/><Button Content="+5s" Click="Forward5_Click"/></StackPanel>
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="ProgressSlider_DragStarted" PreviewMouseLeftButtonUp="ProgressSlider_DragCompleted"/>
                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00:00.000 / 00:00:00.000" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Velocidade" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/><ComboBox x:Name="SpeedCombo" Width="85" Margin="7,0,16,0" SelectionChanged="SpeedCombo_SelectionChanged"><ComboBoxItem Content="0,25x" Tag="0.25"/><ComboBoxItem Content="0,5x" Tag="0.5"/><ComboBoxItem Content="1,0x" Tag="1" IsSelected="True"/><ComboBoxItem Content="1,5x" Tag="1.5"/><ComboBoxItem Content="2,0x" Tag="2"/></ComboBox><Button x:Name="CaptureFrameButton" Content="Capturar frame" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureFrame_Click"/><TextBlock x:Name="ReadOnlyInspectionText" Text="Somente leitura: alterações bloqueadas." Foreground="{StaticResource DangerBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Anomalias do trecho" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="AnomalySummaryText" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="AnomalyListSearchBox" Width="170" ToolTip="Pesquisar anomalias" TextChanged="AnomalyListFilterChanged"/><ComboBox x:Name="AnomalyStatusFilter" Width="125" Margin="7,0" SelectionChanged="AnomalyListFilterChanged"><ComboBoxItem Content="Todas" Tag="All" IsSelected="True"/><ComboBoxItem Content="Completas" Tag="Complete"/><ComboBoxItem Content="Incompletas" Tag="Incomplete"/></ComboBox><Button x:Name="NewOccurrenceButton" Content="+  Cadastrar anomalia" Style="{StaticResource PrimaryButtonStyle}" Click="NewOccurrence_Click"/></StackPanel></Grid>
                            <Grid Grid.Row="1"><ListBox x:Name="OccurrencesList" AllowDrop="True" PreviewMouseLeftButtonDown="OccurrencesList_PreviewMouseLeftButtonDown" PreviewMouseMove="OccurrencesList_PreviewMouseMove" Drop="OccurrencesList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="9,6" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="☰" Cursor="SizeAll" Foreground="{StaticResource TextMutedBrush}" FontSize="17" VerticalAlignment="Center" ToolTip="Arraste para reordenar"/><TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Anomalies}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Completeness}" Foreground="{Binding CompletenessColor}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding EvidenceSummary}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="4" Orientation="Horizontal"><Button Content="Editar" Tag="{Binding Id}" Click="EditOccurrence_Click"/><Button Content="Duplicar" Tag="{Binding Id}" Click="DuplicateOccurrence_Click" IsEnabled="{Binding CanModify}"/><Button Content="Ir ao vídeo" Tag="{Binding Id}" Click="GoToOccurrenceVideo_Click" IsEnabled="{Binding CanGoToVideo}"/><Button Content="×" MinWidth="38" Width="38" Padding="4" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteOccurrence_Click" IsEnabled="{Binding CanModify}" ToolTip="Excluir"/></StackPanel></Grid></Border>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                                <StackPanel x:Name="OccurrencesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="OccurrencesEmptyTitle" Text="Nenhuma anomalia registrada neste trecho." FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OccurrencesEmptyDescription" Text="Durante a inspeção, capture um frame para começar." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Expander Grid.Row="4" Margin="0,8,0,0"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Capturas pendentes" FontWeight="SemiBold"/><TextBlock x:Name="PendingCapturesSummary" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/></StackPanel></Expander.Header>
                            <ListBox x:Name="CapturesList" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="6" Margin="4" Width="180"><StackPanel><Image Source="{Binding Thumbnail}" Height="80" Stretch="Uniform"/><TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/><WrapPanel><Button Content="Cadastrar" Tag="{Binding Id}" Click="CreateOccurrenceFromPending_Click"/><Button Content="Ir ao vídeo" Tag="{Binding Id}" Click="GoToCapture_Click"/><Button Content="Excluir" Style="{StaticResource DangerButtonStyle}" Tag="{Binding Id}" Click="DeleteCapture_Click"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </Expander>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="WordConfigTab" Header="Relatórios">
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0"><DockPanel Margin="0,0,0,10"><Button x:Name="NewReportButton" Content="+  Novo relatório" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Click="NewReport_Click"/><TextBlock Text="Relatórios" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                            <ComboBox x:Name="ReportsCombo" Visibility="Collapsed" DisplayMemberPath="DisplayCode" SelectionChanged="ReportsCombo_SelectionChanged"/>
                            <Grid><ListBox x:Name="ReportsList" SelectionChanged="ReportsList_SelectionChanged" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="13" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DisplayCode}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='Data não informada'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SectionLinks.Count, StringFormat={}{0} trecho(s)}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Finalizado"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding GeneratedReportPath}" Value="{x:Null}"><Setter Property="Text" Value="Em andamento"/><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding GeneratedReportPath}" Value=""><Setter Property="Text" Value="Em andamento"/><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Abrir preparação" Foreground="{StaticResource PrimaryBrush}" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <StackPanel x:Name="ReportsEmptyState" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Nenhum relatório criado" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Crie o primeiro relatório para preparar o documento." Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="Novo relatório" HorizontalAlignment="Center" Margin="0,10,0,0" Click="NewReport_Click"/></StackPanel>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                                <StackPanel Margin="0,0,0,16"><TextBlock x:Name="ActiveReportTitle" Text="Selecione um relatório" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/><TextBlock Text="Preparação do documento" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                <Grid x:Name="ReportHeaderTab" Visibility="Collapsed"><TextBox x:Name="ClientBox"/><TextBox x:Name="CnpjBox"/><TextBox x:Name="AreaBox"/><TextBox x:Name="ContractBox"/><TextBox x:Name="PurchaseOrderBox"/><TextBox x:Name="TemplateBox"/><TextBox x:Name="LogoBox"/></Grid>
                                <TextBlock Text="Dados da emissão" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Grid Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Código do relatório" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="ReportCodeBox" TextChanged="FieldChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Data" Style="{StaticResource FieldLabelTextStyle}"/><DatePicker x:Name="ReportDatePicker" SelectedDateChanged="FieldChanged"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Metragem total (m)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="MetersBox" TextChanged="FieldChanged"/></StackPanel>
                                </Grid>

                                <TextBlock Text="Equipamentos" Style="{StaticResource SectionTitleTextStyle}"/>
                                <WrapPanel Margin="0,8,0,12"><ToggleButton x:Name="EndoscopeCheck" Content="Endoscópio" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="BugCheck" Content="BUG" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="HunterCheck" Content="HUNTER" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="SpiderCheck" Content="SPIDER" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="TrackerCheck" Content="TRACKER" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/></WrapPanel>

                                <TextBlock Text="Diâmetros filmados" Style="{StaticResource SectionTitleTextStyle}"/>
                                <WrapPanel Margin="0,8,0,4"><ToggleButton x:Name="D300Check" Content="300 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D400Check" Content="400 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D500Check" Content="500 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D600Check" Content="600 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D800Check" Content="800 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D1000Check" Content="1000 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="D1500Check" Content="1500 mm" Style="{StaticResource SelectionChipStyle}" Checked="FieldChanged" Unchecked="FieldChanged"/><ToggleButton x:Name="OtherDiameterToggle" Content="+ Outro" Style="{StaticResource SelectionChipStyle}" Checked="OtherDiameterToggle_Changed" Unchecked="OtherDiameterToggle_Changed"/></WrapPanel>
                                <StackPanel x:Name="CustomDiameterPanel" Visibility="Collapsed" Margin="0,0,0,16"><TextBlock Text="Diâmetro adicional (use vírgulas para vários valores)" Style="{StaticResource FieldLabelTextStyle}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="CustomDiametersBox" Width="340" ToolTip="Ex.: 250, 1200" TextChanged="FieldChanged"/><TextBlock Text="mm" Margin="8,0,0,12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel>

                                <TextBlock Text="Desenvolvimento" Style="{StaticResource SectionTitleTextStyle}"/>
                                <StackPanel Margin="0,8,0,14"><CheckBox Content="Vídeo inspeção" IsChecked="True" IsEnabled="False"/><CheckBox x:Name="OpeningCheck" Content="Abertura de inspeção" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/><CheckBox x:Name="GprCheck" Content="Complemento GPR / Georadar" Margin="0,5" Checked="FieldChanged" Unchecked="FieldChanged"/></StackPanel>

                                <TextBlock Text="Imagem de localização" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="12" Margin="0,8,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="LocationImagePreview" Width="140" Height="90" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0"><TextBlock x:Name="LocationImageStatus" Text="Nenhuma imagem selecionada" FontWeight="SemiBold"/><TextBlock Text="A imagem será inserida automaticamente no relatório." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="Alterar imagem" VerticalAlignment="Center" Click="SelectLocationImage_Click"/><TextBox x:Name="LocationImageBox" Visibility="Collapsed"/></Grid></Border>

                                <TextBlock Text="Imagens do desenvolvimento" Style="{StaticResource SectionTitleTextStyle}"/>
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel x:Name="VideoInspectionImagesPanel" Margin="0,3,0,10"><DockPanel><Button Content="Alterar" Tag="VideoInspection" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock Text="Vídeo inspeção" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl x:Name="VideoInspectionImagesList" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Width="104" Padding="5" Margin="0,0,7,7"><StackPanel><Image Source="{Binding Thumbnail}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="VideoInspectionImagesText" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                    <StackPanel x:Name="OpeningImagesPanel" Margin="0,3,0,10"><DockPanel><Button Content="Alterar" Tag="InspectionOpening" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock Text="Abertura de inspeção" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl x:Name="OpeningImagesList" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Width="104" Padding="5" Margin="0,0,7,7"><StackPanel><Image Source="{Binding Thumbnail}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="OpeningImagesText" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                    <StackPanel x:Name="GprImagesPanel" Margin="0,3"><DockPanel><Button Content="Alterar" Tag="Gpr" DockPanel.Dock="Right" Click="SelectDevelopmentImages_Click"/><TextBlock Text="GPR / Georadar" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl x:Name="GprImagesList" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Width="104" Padding="5" Margin="0,0,7,7"><StackPanel><Image Source="{Binding Thumbnail}" Height="64" Stretch="Uniform"/><TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="GprImagesText" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Selecionar todos" Click="SelectAllReportSections_Click"/><Button Content="Limpar" Click="ClearReportSections_Click"/></StackPanel><TextBlock Text="Trechos do relatório" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10" MaxHeight="190"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportSectionsList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" Tag="{Binding SectionId}" IsChecked="{Binding IsSelected}" Margin="4" Checked="ReportSectionSelectionChanged" Unchecked="ReportSectionSelectionChanged"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>


                                <DockPanel Margin="0,18,0,8"><Button Content="+  Adicionar seção" DockPanel.Dock="Right" Click="AddCustomSection_Click"/><TextBlock Text="Etapas adicionais" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/></DockPanel>
                                <ItemsControl x:Name="CustomSectionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="10" Margin="0,4"><DockPanel><Button Content="Remover" Style="{StaticResource DangerButtonStyle}" DockPanel.Dock="Right" Tag="{Binding Id}" Click="RemoveCustomSection_Click"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="650" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Images.Count, StringFormat={}{0} imagem(ns)}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="ReportReviewTitle" Text="Revisão do relatório" FontWeight="SemiBold"/><TextBlock x:Name="ReportReviewSummary" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ReportReviewIssues" Margin="0,7,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,8"><Button x:Name="OpenReportButton" Content="Abrir arquivo" IsEnabled="False" Click="OpenReport_Click"/><Button x:Name="OpenReportFolderButton" Content="Abrir pasta" IsEnabled="False" Click="OpenReportFolder_Click"/><Button Content="Gerar relatório" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateReport_Click" MinWidth="170"/></StackPanel>
                                <TextBlock x:Name="GeneratedReportText" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ProjectDefaultsTab" Header="Dados do projeto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0"><StackPanel MaxWidth="940" HorizontalAlignment="Left"><TextBlock Text="Dados do projeto" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/><TextBlock Text="Estas informações são herdadas automaticamente pelos novos relatórios." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Cliente" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultClientBox" TextChanged="FieldChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CNPJ" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultCnpjBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="Área / localização" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultAreaBox" TextChanged="FieldChanged"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Contrato" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultContractBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Pedido de compra" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="DefaultPurchaseOrderBox" TextChanged="FieldChanged"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Logo do cliente" Style="{StaticResource FieldLabelTextStyle}"/><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="7" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="DefaultLogoPreview" Width="80" Height="58" Stretch="Uniform"/><TextBlock x:Name="DefaultLogoStatus" Grid.Column="1" Text="Nenhuma imagem selecionada" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0"/><Button Grid.Column="2" Content="Alterar imagem" VerticalAlignment="Center" Click="SelectDefaultLogo_Click"/><TextBox x:Name="DefaultLogoBox" Visibility="Collapsed"/></Grid></Border></StackPanel>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="2" x:Name="SaveStatus" Text="✓ Salvo" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,6,0,0"/>
        </Grid>

        <Grid x:Name="InspectionFormOverlay" Visibility="Collapsed" Background="#B5000000" Panel.ZIndex="20">
            <Border Width="620" MaxWidth="620" MaxHeight="680" Margin="24" Padding="26,22" CornerRadius="10" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <StackPanel x:Name="NewLocationPanel" Visibility="Collapsed">
                        <TextBlock Text="Novo local" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/>
                        <TextBlock Text="Informe um nome para organizar os trechos da inspeção." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,20"/>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Nome do local "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock>
                        <TextBox x:Name="NewLocationNameBox" MaxLength="180"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancelar" Click="CancelInspectionForm_Click"/><Button x:Name="CreateLocationButton" Content="Adicionar" Style="{StaticResource PrimaryButtonStyle}" Click="CreateLocation_Click"/></StackPanel>
                    </StackPanel>
                    <Grid x:Name="NewSectionPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Novo trecho" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/><TextBlock Text="Informe a identificação e complete somente os dados disponíveis." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><Grid Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="3"><TextBlock Style="{StaticResource FieldLabelTextStyle}"><Run Text="Identificação "/><Run Text="*" Foreground="{StaticResource DangerBrush}"/></TextBlock><TextBox x:Name="NewSectionNameBox" MaxLength="180"/></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="Ponto inicial (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionStartBox"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Ponto final (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionEndBox"/></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Diâmetro (mm, opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionDiameterBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Referência (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionReferenceBox"/></StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3"><TextBlock Text="Descrição (opcional)" Style="{StaticResource FieldLabelTextStyle}"/><TextBox x:Name="NewSectionDescriptionBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/></StackPanel>
                        </Grid></ScrollViewer>
                        <Grid Grid.Row="2"><TextBlock x:Name="NewSectionValidationText" Text="Campos opcionais podem permanecer vazios." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="CancelInspectionForm_Click"/><Button x:Name="CreateSectionButton" Content="Criar trecho" Style="{StaticResource PrimaryButtonStyle}" Click="CreateSection_Click"/></StackPanel></Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
